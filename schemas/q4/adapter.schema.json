{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QL-MEF Q4 Optional Client Adapter",
  "$defs": {
    "ClientRef": {"type": "string", "minLength": 1},
    "QlMode": {"type": "string", "enum": ["disabled", "optional", "required"]},
    "LensRef": {"type": "string", "pattern": "^mef:lens:L[0-5]'?@1$"},
    "SublensRef": {"type": "string", "pattern": "^mef:sublens:L[0-5]'?\\.[0-5]@1$"},
    "ClientSubject": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": {"$ref": "#/$defs/ClientRef"},
        "revision": {"type": ["string", "null"]},
        "subject_type": {"type": ["string", "null"]},
        "frame_ref": {"type": ["string", "null"]},
        "context_refs": {"type": "array", "items": {"$ref": "#/$defs/ClientRef"}}
      },
      "additionalProperties": false
    },
    "QlAttachment": {
      "oneOf": [
        {"type": "object", "required": ["state"], "properties": {"state": {"const": "disabled"}}, "additionalProperties": false},
        {"type": "object", "required": ["state", "health", "reading"], "properties": {"state": {"const": "reading"}, "health": {"type": "object"}, "reading": {}}, "additionalProperties": false},
        {"type": "object", "required": ["state", "health", "reason"], "properties": {"state": {"const": "unavailable"}, "health": {"type": "object"}, "reason": {"type": "string"}}, "additionalProperties": false},
        {"type": "object", "required": ["state", "message"], "properties": {"state": {"const": "failed"}, "health": {"type": ["object", "null"]}, "message": {"type": "string"}}, "additionalProperties": false}
      ]
    },
    "RefractionRequest": {
      "type": "object",
      "required": ["subject", "lens"],
      "properties": {
        "subject": {"$ref": "#/$defs/ClientSubject"},
        "lens": {"$ref": "#/$defs/LensRef"},
        "sublens": {"oneOf": [{"$ref": "#/$defs/SublensRef"}, {"type": "null"}]},
        "frame": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
