{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.epilogos.dev/ql-mef/v1/contracts.schema.json",
  "$defs": {
    "QLFormRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "enum": ["sixfold", "four-plus-two", "direct-conjugate"] },
        "version": { "type": "integer", "const": 1 }
      }
    },
    "LensRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "enum": ["L0", "L0′", "L1", "L1′", "L2", "L2′", "L3", "L3′", "L4", "L4′", "L5", "L5′"] },
        "version": { "type": "integer", "const": 1 }
      }
    },
    "QLAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "position", "face", "depth"],
      "properties": {
        "frame": { "$ref": "#/$defs/QLFormRef" },
        "position": { "type": "integer", "minimum": 0, "maximum": 5 },
        "face": { "type": "string", "enum": ["direct", "conjugate"] },
        "depth": { "type": "integer", "minimum": 0 }
      }
    },
    "QLProviderCapabilities": {
      "type": "object",
      "required": ["provider", "schemaVersion", "kernelVersion", "supportedForms", "supportedLenses", "operations", "deterministicOperations", "stochasticOperations", "extensionNamespaces"]
    }
  }
}
