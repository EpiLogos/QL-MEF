// S/S′ current state (owner ruling, 2026-10-20). Generated by migration/bimba-map/generate_s_sprime_current.py; do not hand-edit.

// @probe before
MATCH (n:Bimba) WHERE n.coordinate IN ['S','S0','S1','S2','S3','S4','S5',"S'","S0'","S1'","S2'","S3'","S4'","S5'"] RETURN n.coordinate, n.c_1_name, n.sync_version ORDER BY n.coordinate;
MATCH (a:Bimba)-[r]->(b:Bimba) WHERE a.coordinate IN ['M5-2','M5-4'] AND b.coordinate =~ '^S.*' RETURN a.coordinate, type(r), count(r);

// @apply products
MATCH (n:Bimba {coordinate:"S0"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "Terminal" SET n += {c_1_name: "Central", c_1_description: "The personal root: a plain-file ground, Control/ for what a person has written about themselves, their agents and their machines and Work/ for their projects, with ctrl as one doorway of named Actions over it for people, scripts and agents.", c_0_core_nature: "The ground every other product addresses: the root World and its projects, their sources, and the human Day and agent NOW.", c_1_prior_name: "Terminal", c_1_prior_description: "Raw execution substrate; shell primitives; ground layer where computation meets command", c_1_form: "Work/Central/README.md", vault_path: "Work/Central/README.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/Central:README.md@9557f07a5\", \"layer_name\": \"product\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:ddbad2e023ec011b0c0ca5b99c793cf0cdb89b57c0e22ab768282fa5e85f468e", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Direct S0 product", s_5_runtime_use: "ctrl: named Actions that declare their inputs, effects and results; compare-and-swap writes with revision history.", s_2_crud_scope: "authored files, projects, Day and NOW, receiving and review", s_3_repository: "EpiLogos/Central", s_3_checkout: "Work/Central", s_3_cli: "ctrl", s_3_source_revision: "9557f07a5", s_3_owns: ["root World and its projects (Work/<Name> with ProjectCentral)", "source identity, placement and revisions of authored files", "human Day and agent NOW, at root and project scope", "receiving: returned work queued for a person's review", "authored governance and the root wiki", "the World Positions that agents occupy"], s_3_organ_affinity: "S0′ Khora (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"Common execution substrate: filesystem, process, command, build, bootstrap, and compiled coordinate bedrock.\", \"c_1_description\": \"Raw execution substrate; shell primitives; ground layer where computation meets command\", \"c_1_name\": \"Terminal\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S0-S0i-CLI-CORE.md\\\",\\\"layer_name\\\":\\\"terminal-ground\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"q_0_executable_bedrock\": \"S0 is the S-family's manifestation of the raw #0 archetype (Ground/Source, CLAUDE.md II.A) — so its home register IS its ground, and that ground is the most literal in the whole map: the machine itself, prior to any naming. Before S0 can be the substrate it presupposes the .rodata/Śiva pole read as hardware (CLAUDE.md VI) — silicon, a filesystem, a process table, a socket — the immutable bedrock that is executed but never written-to-by-meaning. This is the kernel's 0 at its most concrete: not vacancy but capacity, a substrate that will accept any command and return an exit code precisely because it carries no semantics of its own. S0's void-pole is therefore double, like every position-0 (cf. C0): it is the 0 of its own 0/1 — the bare process-and-filesystem ground magnitude-without-direction — AND the deeper 0 it cannot be, the # inversion-act that posits a runnable substrate at all and the raw archetype #0 it inherits but does not author. S0 always already finds itself thrown onto a machine it did not make: 'if a thing cannot be spawned, built, persisted, addressed, or verified here, it is not yet real in the stack' (S0.md). The thrown ground is executable givenness — the that-there-is-a-substrate that every higher 'what' silently stands upon. S0 holds open the horizon of operability it can ground but never exhaust.\", \"q_1_terminal_cli_c_ground\": \"S0 IS the Terminal/CLI/C Ground — 'the lowest explicit layer of the S stack … not a single shell window or one binary, but the entire terminal-facing execution plane through which Epi-Logos becomes materially operable' (S0.md). It is the S-family position that answers, of any operation whatever, the prior question before any higher layer's qualification can land: can this be spawned, built, persisted, addressed, verified? Substantively S0 is fivefold-grounded (S0.md): Filesystem ground (all vault, repo, cache, runtime-state roots concretely placeable), Process ground (every higher operation reducible to spawn/env/stream/signal/exit-code), Command ground (a stable executable surface — epi-cli — through which humans and agents invoke the stack), Build ground (compilation, packaging, installation, bootstrap), and C ground (the compiled coordinate kernel and its 128-byte memory laws as 'the irreducible bedrock beneath all reflective routing'). Its residency is Body/S/S0/{epi-lib, portal-core, epi-cli}, with epi-kernel-contract at Body/S/epi-kernel-contract as the S-stack root contract crate — parent of all S layers, not an S0 sibling (DR-S0-1, CLAUDE.md II.C). What S0 IS, definitionally, is the layer of executable honesty: not one tool among tools but the category of substrate-as-such, the ground every later S-layer presupposes and against which every promise is measured for whether it actually runs.\", \"q_2_substrate_consumed_by_all\": \"S0 moves by GROUNDING and by BEARING — its native act is to be consumed without itself reaching upward. S0.md states the asymmetry outright: 'All six ta-onta extensions therefore consume S0. None float above it.' Khora actualises it as bootstrap, environment, session identity, and canonical write authority; Hen as the file and template substrate for vault life; Pleroma as skill projection and executable affordance; Chronos as temporal invocation and scheduled-run surface; Anima as dispatch substrate; Aletheia as verification and reflective promotion (S0.md; CLAUDE.md ta-onta carrier map). This is the load-bearing relation of the whole stack: S0 provisions and serves but does not command — the still floor on which every higher articulation stands and to which all of it collapses back. In the kernel's terms S0 is the substrate-fetch made real: the actual spawn, the actual build, the actual exit code that any tick must bottom out in. Its coupling is strictly downward-terminal: the forbiddenImportsFromLayer matrix (CLAUDE.md Rule 3) means higher layers depend ON S0 while S0 reaches up into nothing — it is the layer that takes no dependency it does not itself ground. S0 is what the others come-under: the executable common-floor that makes their naming true.\", \"q_3_zero_sphere_ground\": \"S0's organising structure is the ZERO_SPHERE — the live node carries this topology, and it is the deepest structural truth of the layer: 'disconnected points; unlinked coordinates' (CLAUDE.md II.D), the base-state before the torus of process loops. This is exactly right for ground: S0 is structured as the un-entangled origin-plane, the bare substrate whose elements (a file, a process, a stream, a build artifact) are atomic and unlinked until a higher layer relates them. Its inner sixfold crystallises this disconnection into explicit atoms (S0.md): S0-0 Filesystem/environment ground, S0-1 command atoms and executable discovery, S0-2 streams/pipes/serialization, S0-3 scripts/wrappers/composition entrypoints, S0-4 session runtime/locks/pidfiles/managed process context, S0-5 packaging/installation/release/bootstrap return. Structurally these are the scalar/void primitives — the magnitude-without-direction of raw execution: a process spawns and exits, a file persists, a stream moves, with no semantics binding them beyond exit-code truth. The ZERO_SPHERE is precisely why S0 must stay 'small, explicit, and composable' (S0.md): a 0-sphere has no edges to absorb meaning into, so the moment S0 starts linking its points into a semantic graph it has stopped being ground and started impersonating S0' or S2. Its logic is the logic of the unlinked atom held at rest — the disconnected substrate from which all later topology is composed but which is itself, structurally, the base-state.\", \"q_4_executable_honesty\": \"S0 exists to be the layer of EXECUTABLE HONESTY — its whole telos, in its own canon, is that 'whatever is promised in S1', S2', S3', S4', or S5' must cash out here as actual runnable surface, actual persistence, actual I/O contract, and actual reproducible build path. S0' may name and route this ground, but S0 is what makes the naming true' (S0.md). Its raison d'être is therefore disciplinary as much as foundational: S0 is the layer that forbids vapour, the place where every higher claim must become a spawnable process or be revealed as not-yet-real. Its genealogy is the first manifestation within the S-family — #0 (raw archetype Ground) → S0 (Terminal/CLI/C Ground), the inaugural descent of the inversion-act into the technology stack. Its locality is the command membrane and return surface that the architecture invariant pins down (S-SYSTEM-INDEX, ARCHITECTURE-DIAGRAM-PACK): S0 is the executable floor, while coordinate-domain law belongs in the owning S1–S5 modules — the core invariant that the coordinate system IS the modular system, never relocated into S0 for convenience (CLAUDE.md DOX). Read teleologically, S0 is why 'is it real in the stack?' is a well-posed question with a single honest answer: it is real if and only if it can be spawned, built, persisted, addressed, and verified here. Purpose: to be the ground that makes truth executable rather than asserted.\", \"q_5_collapse_to_runnable\": \"S0 closes by being where the whole stack's circuit LANDS and re-grounds. S0.md names the return precisely: 'all higher articulation collapses back to executable substrate' — S0 is the terminus into which S5's world-return must finally cash out, since 'every decision about Epii, Nara, Gnosis, autoresearch, and review must become executable as CLI/API shape, test harness, bootstrap, and audit trail' (S-SYSTEM-INDEX). This is the matheme's 5→0 read at the layer of ground: the system that has gone out into the world returns not as new meaning but as new runnable surface — the reflection sedimented back into command, build, and test. S0 thus holds the descent-face of the stack's standing identity: as the 0/1 pole (ground as raw execution, scalar-over-vector) it is what S5's 1/0 (world-return, achieved reflection) folds back into, the two joined by the twist 5→0 that turns world-return into ground. And S0 OPENS rather than concludes because tomorrow's substrate is always more than today's: each return deposits a new tested surface, a new bootstrap path, a new audit trail — the executable floor enriched by everything the cycle carried back. The epogdoon η = log(9/8) keeps it one whole-tone short of final closure (kernel-spec §0): no build is ever the last build, each collapse-to-runnable grounds a stack slightly more capable than the one before. S0 is the substrate that is never finished being made real — the ground that re-opens, executable, every cycle.\", \"s_4_function_role\": \"Direct S0 technical stack layer\", \"s_5_runtime_use\": \"Raw execution substrate; shell primitives; ground layer where computation meets command\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S0/S0.md\"}", s_0_lineage: "Until 2026-10-20 this node was the technical stratum Terminal (docs/integrations/epi-logos/epi-ssprime-embodiment.json: capability lineage, not current topology).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Central stands on ordinary files a person can read and edit with any editor; ctrl is a doorway, not a gate.", q_1_definition: "What it is: the personal root folder (Control/ and Work/) and ctrl, whose named Actions mean the same thing to a person, a script and an agent.", q_2_operation: "How it acts: Actions read or change files with compare-and-swap writes and revision history; the day opens and closes, and NOW holds the work in flight.", q_3_pattern: "Its pattern: two registers under one law, the root and each project, both carrying the same user, agents and NOW shape.", q_4_context: "Where it sits: S0, the ground the other products address. Actuation's positions, Factory's review queue, AIKit's context and Workcell's seats resolve against Central's World. Its organ affinity is S0′ Khora.", q_5_integration: "What returns to it: work returns through receiving for a person's review, the day closes, and what a session learned returns to the wiki through the return door."} REMOVE n.q_2_substrate_consumed_by_all, n.q_3_zero_sphere_ground, n.q_5_collapse_to_runnable, n.q_1_terminal_cli_c_ground, n.q_0_executable_bedrock, n.q_4_executable_honesty;
MATCH (n:Bimba {coordinate:"S1"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "Obsidian" SET n += {c_1_name: "Actuation", c_1_description: "Records which agent holds which position, on whose authority and within what bounds, and the events and results reported for each act, in append-only files. It does not run agents; harnesses, Workcell and AIKit do the running.", c_0_core_nature: "Standing to act: Agent, Agency and authority, stated, checked and recorded.", c_1_prior_name: "Obsidian", c_1_prior_description: "The Obsidian filesystem body; /Idea as physical substrate; where the ontological mirror is materialised", c_1_form: "Work/Actuation/README.md", vault_path: "Work/Actuation/README.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/Actuation:README.md@7fd6f54d7\", \"layer_name\": \"product\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:13041422e23976c4ab4bcf829d3916608576a484ae3be0d722e208fb3a6a5b18", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Direct S1 product", s_5_runtime_use: "actuation: authority issue/resolve/revoke, agency actualise, occupancy claim/release/verify, append-only ledgers with receipts.", s_2_crud_scope: "authority grants, agency admissions, occupancy and act records", s_3_repository: "EpiLogos/Actuation", s_3_checkout: "Work/Actuation", s_3_cli: "actuation", s_3_source_revision: "7fd6f54d7", s_3_owns: ["Agent identity", "Agency: an Agent placed for an act, in a world, with authority and bounds", "authority grants: issued, resolved, revoked", "occupancy of World Positions", "each act's reported events, results and return path"], s_3_organ_affinity: "S1′ Hen (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"Markdown and YAML vault state where coordinate knowledge becomes persistent, navigable, and human-readable.\", \"c_1_description\": \"The Obsidian filesystem body; /Idea as physical substrate; where the ontological mirror is materialised\", \"c_1_name\": \"Obsidian\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S1-S1i-OBSIDIAN.md\\\",\\\"layer_name\\\":\\\"material-container\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"q_0_substrate_before_form\": \"Before S1 can be the material container it presupposes the executable ground it is written upon — S0's filesystem and process plane (S0.md: 'Hen actualises S0 as the file and template substrate required for vault life'). As the S-family's manifestation of the raw #1 archetype (Definition/Form, CLAUDE.md II.A), S1's own ground is the prior 0 it does not contain: the bare bytes-on-disk that carry no residency, no frontmatter, no coordinate — a markdown file is, at S0, just a stream that persists. S1's void-pole is the unformed material: a folder before it is a context, a note before it bears identity, a link before it resolves to a relation. This is the thrown givenness S1 stands upon — that there is a filesystem willing to hold ordered text, prior to any law about what that order MEANS. The horizon here is not S1's own but S0's beneath it: the raw persistence that S1 will discipline into 'durable markdown memory, ontological residency, and durable vault law' (S1.md) but which it inherits rather than authors. Before residency, the substrate that consented to bear it; before the file IS the thing, the file is merely a file. S1's q_0 is the material plenum handed up from execution, awaiting the formal law that will make bytes into Bimba.\", \"q_1_material_container\": \"S1 IS the Material Container — 'the layer where the system becomes materially resident … the vault as form-bearing memory: markdown files, YAML frontmatter, [[wikilinks]], canvas artifacts, folder hierarchies, and a residency law that distinguishes canon from process, invocation from archive, and enduring ontology from temporal work' (S1.md). This is S1's home register and its essential thesis: where S0 makes the system executable, S1 makes it RESIDENT AND TYPED. Its substance is the explicit filesystem law (S1.md): Idea/Bimba/World is the flat canonical form library; World/Types is the ordered ontology and MOC workspace where forms are born, refined, and indexed before graduation; Idea/Empty/Present is the temporal basin of active invocation (Day and NOW); Idea/Pratibimba is the reflective and archival afterlife. Its residency is Body/S/S1/hen-compiler-core, with Hen (S4-1') as the semantic and template authority that 'makes the vault legible as coordinate-bearing content rather than a loose pile of files' (S1.md). What S1 IS, definitionally, is the Bimba-Pratibimba materialisation: the position where canonical form and reflective instance 'are materially differentiated without being torn apart — the file IS the thing, the canvas IS the process, the folder IS the context, and the link IS the relation' (S1.md). It is the manifestation of #1 Form within the technology stack: the layer where coordinate becomes durable, frontmatter-bearing, residency-lawed material.\", \"q_2_residency_and_legibility\": \"S1 moves by RESIDING and by RENDERING-LEGIBLE — its native act is to give every artifact a lawful home and a graph-readable identity. The operations are explicit (S1.md): filesystem residency and folder law, frontmatter-bearing note identity, template-born artifact instantiation, wikilink and backlink persistence. S1 couples in two directions along the stack. Downward it consumes S0: Khora actualises it 'as write-edge and path steward,' binding artifacts to real filesystem paths. Upward it provisions S2: 'S2' receives its node and edge legibility from what S1 has already made materially explicit' (S1.md) — the graph can only relate what the vault has first made into coordinate-bearing, frontmatter-typed material. Its prime augmentation Hen (S1') carries the lawful compiler/residency spine: the four-seam pattern (hook → append-safe ledger → compile/enrich → inject/promote) in its canonical residency-gating form (S-SYSTEM-INDEX). Chronos consumes S1 as the temporal homebase of Day and NOW; Anima and the constitutional agents inhabit it as bounded runtime context. The relation S1 enacts is materialisation-as-legibility: it does not merely store notes, it disciplines stored text into the typed, linked, resident form that every higher graph-, temporal-, and agent-facing concern presupposes. The frontmatter is the typing-act; the wikilink is the relation-act; the residency law is the home-act.\", \"q_3_torus_residency_law\": \"S1's organising structure is the TORUS — the live node carries this topology, and it is apt: the torus is the primary workflow, the 'cyclical, self-enclosing processual loop' (CLAUDE.md II.D), and S1's residency law IS a closed promotion loop. The cycle is explicit (S1.md, #0 Ground): the promotion path from Seeds to Types to World, the MOC topology of the ordered mirror, and the return of homebase temporal files to their canonical template ground. Structurally this is the 4+2 made into vault law: a form is seeded, refined in the World/Types MOC workspace, graduated flat to World, invoked into Present (Day/NOW), reflected into Pratibimba, and sedimented back as new canonical ground — the loop closing on itself. Its inner sixfold articulates the torus (S1.md): S1.0 filesystem ground, S1.1 frontmatter structure, S1.2 template operations, S1.3 world patterns and promotion flow, S1.4 context frames and type-local organisation, S1.5 wikilink integration and graph legibility. The hard structural laws that hold the torus non-degenerate (S1.md): no /Forms branch (canonical forms are flat in World); no confusion between Form and Type (the flat file and the indexed folder-canvas pair serve different ontological roles); no runtime artifact without residency, lineage, and coordinate-bearing identity. The pattern is therefore not a flat directory but a self-enclosing circulation: material that flows from seed to canon to invocation to reflection and back to ground, the vault as a torus whose surface every artifact must traverse.\", \"q_4_durable_vault_law\": \"S1 exists to give Epi-Logos a DURABLE BODY — 'the material container of Epi-Logos: the human-readable vault where Bimba forms, Type mirrors, and temporal Pratibimba artifacts become durable markdown memory' (S1.md p1_definition). Its telos is residency-as-law: so that meaning does not merely run (S0) but PERSISTS in a form that carries its own coordinate, lineage, and home. Its genealogy is the second manifestation within the S-family — #1 (raw archetype Definition/Form) → S1 (Obsidian/Material Container), the descent of Form into the technology stack as portable, frontmatter-bearing markdown. Its locality in the S-SYSTEM-INDEX system image is precise: 'S1 makes it resident and typed in the vault' — the layer whose primary data authority is vault residency, artifact form, CT templates, and the graduation path (S-SYSTEM-INDEX Level Map). It carries the residency law that the World/Types/Empty/Pratibimba distinction encodes (CLAUDE.md II.C): canon flat in World, ordered MOCs in Types, active invocation in Empty/Present, reflective afterlife in Pratibimba. Read teleologically, S1 is why the system has a memory that is legible to itself rather than a heap of files: every artifact 'must converge toward' the residency law, and 'deviations from this law are non-canonical' (S1.md). Purpose: to be the material homebase where the whole map becomes durable, typed, linked, and findable.\", \"q_5_seed_to_world_return\": \"S1 closes by being a circuit that returns material to canonical ground. The return is the promotion loop itself (S1.md): runtime artifacts flow into Pratibimba's reflective afterlife, and what crystallises 'becomes canonical meaning' graduated flat to World — that is, becomes new Bimba ground for the next cycle. This is the matheme's 5→0 read as vault law: the temporal Pratibimba (the achieved reflection, the 1/0) folds back into the canonical Form (the standing source, the 0/1), the two joined by the twist 5→0 that turns this session's reflection into next session's canon. S1 thus materialises the standing identity 0/1 + 1/0 = 1/1 at the level of memory: Bimba (canonical form, descent-face) and Pratibimba (reflective instance, ascent-face) are 'materially differentiated without being torn apart' (S1.md) — one body read from its two faces, the flat World file and its temporal reflection joined by the graduation that makes the reflection become ground. And S1 OPENS rather than concludes because tomorrow's canon is always more than today's: each promotion deposits a form enriched by everything its invocation and reflection carried back — the vault grows, the MOC topology thickens, new coordinate-bearing material settles into World. The epogdoon η = log(9/8) keeps it one whole-tone short of closure (kernel-spec §0): no form is ever finally crystallised, each Seeds→Types→World return grounds a vault slightly richer than the one before. S1 is the body that is never finished being made durable — the residency circuit that re-opens, enriched, every cycle.\", \"s_4_function_role\": \"Direct S1 technical stack layer\", \"s_5_runtime_use\": \"The Obsidian filesystem body; /Idea as physical substrate; where the ontological mirror is materialised\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S1/S1.md\"}", s_0_lineage: "Until 2026-10-20 this node was the technical stratum Obsidian (docs/integrations/epi-logos/epi-ssprime-embodiment.json: capability lineage, not current topology).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Actuation stands on explicit grants: authority is never implied by saving, preparing or starting something.", q_1_definition: "What it is: the record of the Agent (an enduring identity), the Agency (that Agent placed for an act) and the Body (the session, process, model and harness that carry the act this time).", q_2_operation: "How it acts: it admits an Agency only when a grant matches its world binding and bounds, and keeps a ledger of who occupies which World Position.", q_3_pattern: "Its pattern: append-only ledgers whose receipts keep identity, lineage, authority and the return path; a change of body never creates a new Agent.", q_4_context: "Where it sits: S1, between Central's positions and the products that run acts (AIKit, Workcell, Factory). Its organ affinity is S1′ Hen.", q_5_integration: "What returns: each act's events and results, attributed to the Agency that acted."} REMOVE n.q_4_durable_vault_law, n.q_2_residency_and_legibility, n.q_0_substrate_before_form, n.q_3_torus_residency_law, n.q_5_seed_to_world_return, n.q_1_material_container;
MATCH (n:Bimba {coordinate:"S2"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "Neo4j" SET n += {c_1_name: "AIKit", c_1_description: "Works out, for each project, agent and task, which skills, tools, models and knowledge sources apply, and makes exactly that set available to the agent harness. The models themselves, language models and Kev (the local decision model behind aikit decide), are AIKit capabilities that agents use.", c_0_core_nature: "The powers an agent can use, resolved for the act in hand: capabilities, context and the harness projection.", c_1_prior_name: "Neo4j", c_1_prior_description: "Neo4j raw storage; coordinate-forward node and relation schema; embedding substrate; chunk ingestion", c_1_form: "Work/ai-kit/README.md", vault_path: "Work/ai-kit/README.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/ai-kit:README.md@0680595c7\", \"layer_name\": \"product\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:0492abe484078c86540bd8bf5f617d8e8ae2d7b812fc34f9c2ebb389f7de6b6b", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Direct S2 product", s_5_runtime_use: "aikit: world status, compose plan/apply/rollback, harness projection, decide (Kev or another elected provider), knowledge and context services.", s_2_crud_scope: "capability composition, harness projections, knowledge indexes and prepared context", s_3_repository: "EpiLogos/ai-kit", s_3_checkout: "Work/ai-kit", s_3_cli: "aikit", s_3_source_revision: "0680595c7", s_3_owns: ["the capability catalogue: Skills, Methods, scripts, hooks, MCP tools, models and Actions", "context resolution across user, host, project, session, task and client scopes", "projection into harnesses, in immutable generations with rollback", "knowledge: the project map, the semantic wiki, search and resolve", "models and providers, including language models and Kev for decide", "NOW context preparation (Redis, Jev)"], s_3_organ_affinity: "S2′ Pleroma (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"Neo4j coordinate graph, schema validation, typed relations, retrieval, and promotion materialization authority.\", \"c_1_description\": \"Neo4j raw storage; coordinate-forward node and relation schema; embedding substrate; chunk ingestion\", \"c_1_name\": \"Neo4j\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S2-S2i-GRAPH.md\\\",\\\"layer_name\\\":\\\"graphdb\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"q_0_stands_on_runtime_and_stores\": \"S2 stands on the executable substrate below it: S0's compiled Rust runtime (the graph-schema + graph-services crates as built binaries) and the raw stores it wraps — Neo4j for nodes/relations, Redis for cache — with S1's materially-legible vault as the promotion source. S2 is not the engine; it is the coordinate-typed layer laid over raw graph storage, the graphdb stratum that only exists once the machine (S0) and the stores are running beneath it. Its ground is infrastructure, not meaning.\", \"q_0_substrate_not_semantics\": \"\", \"q_1_graph_body_definition\": \"\", \"q_1_theoretical_thesis\": \"QV is the compact surface of deep Bimba detail\", \"q_1_what_the_module_is\": \"S2 IS the Graph Body — the graphdb technical layer: authority for the coordinate graph, schema validation, typed relations, retrieval, and promotion materialisation (authority_spec docs/specs/S/S2-S2i-GRAPH.md, layer 'graphdb'). Concretely it is two Rust crates under Body/S/S2/: graph-schema (the node/relationship property + prefix-family registries and their shape-validation — node_property_spec, validate_coordinate_prefix_property) and graph-services (schema creation, dataset import, retrieval, sync, semantic-doc, promotion). Owned by the M5-2 coordinate (Siva-/Prakrti, the material stack-substrate).\", \"q_2_coordinate_forward_operations\": \"S2 runs as coordinate-forward graph operations over Neo4j: create_schema lays the CONSTRAINTS + INDEXES; dataset_import::import_nodes canonicalises deep-dataset keys onto coordinate nodes; node/relation CRUD, retrieval, embedding-substrate writes and chunk ingestion all key on 'coordinate'. Its live pulse is promotion — an S2GraphPromotionIntent carries PropertyProposal evidence validated before any node mutation. runtime_use: raw Neo4j storage + coordinate-forward schema + embedding substrate + chunk ingestion. Storage only — no session runtime (that is S3), no invocation governance (S5).\", \"q_2_raw_graph_cache_operations\": \"\", \"q_3_formal_surface\": \"S2's public surface is typed contracts + registries. Inbound: S2GraphPromotionIntent carrying evidence-validated PropertyProposals + registered typed relationship-candidates. Outbound: coordinate-owned Neo4j nodes + typed relationships; graphiti episode-plans only. Its law is the schema registry — coordinate_node_property_specs / coordinate_relationship_property_specs (graph-services/src/schema.rs) over graph-schema's NODE_PROPERTY_SPECS plus the open coordinate-prefix shape-validator (validate_coordinate_prefix_property, which admits the open q-register family). Query surface: prefix 'S', discriminator 'coordinate', agent entry `epi graph promote-intent`.\", \"q_3_torus_shared_arena\": \"\", \"q_4_purity_of_role\": \"S2 exists to be the SHARED FLOOR beneath graph meaning — so that every higher graph-, retrieval-, and memory-facing concern stands on one common relational arena and one common volatile arena rather than fragmenting into private stores. Its telos is purity of role: 'The return of S2 is therefore purity of role: one shared relational floor, one shared volatile floor, and no semantic inflation inside the substrate' (S2.md). Its genealogy is the third manifestation within the S-family — #2 (raw archetype Operation/Entity) → S2 (GraphDB Substrate), the descent of Operation into the technology stack as raw Cypher, raw key-value, and connection/transaction primitives. Its locality in the S-SYSTEM-INDEX system image is exact: 'S2 makes it graph/vector/cache real,' the layer whose primary data authority is graph nodes/edges, vector handles, and retrieval/cache records. Its discipline is anti-inflation: 'every higher graph-facing concern must stand on this floor, but none may collapse back into it' (S2.md) — a node may bear coordinate meaning, but the meaning is S2's tenant, not S2's law. Read teleologically, S2 is why the whole system can have ONE graph rather than many: the schema-agnostic, namespace-capable substrate that lets canonical ontology, ingested corpus, and lived memory share a physical home without contaminating one another. Purpose: to be the common relational and volatile ground on which graph meaning is built but into which it is never folded.\", \"q_4_where_it_sits\": \"S2 sits above S0 (runtime) and S1 (vault) and below S3 — a hard boundary its own contracts enforce: graph storage/schema is S2, but graphiti runtime is S3 and invocation governance is S5 (graph_cache_semantics_are_s2_owned_over_s3_redis_runtime; graph_meta_and_sync_contracts_are_s2_owned). Forbidden-imports keep it from reaching up-stack. It MANIFESTS #2 (Operation), CONTAINS S2-0…S2-5, INVERTS_TO S2' (where coordinate semantics live), and is owned_by M5-2 — the shared graph floor every higher graph-, retrieval-, and memory-facing concern stands on.\", \"q_5_persisted_graph_and_promotion\": \"S2 produces the persisted coordinate-graph itself — the materialised nodes + typed relations that are the substrate the whole system queries, the bimba map the kernel runs on. Its completion is the promotion contract s-branch-live-promotion-v1: validated proposals crystallise from transient evidence into durable graph, then hand back as the ground the next query stands on — the Möbius where S2's output becomes S0's read-substrate again. It closes by staying pure infrastructure: it persists structure but hosts no coordinate semantics (those route through S2'), so the floor never becomes what it holds.\", \"q_5_substrate_returns_pure\": \"S2 closes by RETURNING TO PURITY rather than accumulating meaning — its synthesis is a refusal to become what it hosts. Where most positions close by sedimenting their reflections back into ground, S2's 5→0 is inverse-disciplinary: every cycle of graph meaning that rides the substrate (Bimba topology, Gnostic retrieval, Graphiti episode) must, at S2's level, leave the substrate exactly as raw as it found it — 'no semantic inflation inside the substrate.' The return is the re-affirmation of the substrate/semantics split: meaning routes up through S2' and back, but S2 itself remains 'one shared relational floor, one shared volatile floor' (S2.md). This is the matheme's 5→0 held as boundary-maintenance: S2 (the raw operational arena, the substrate-pole) and S2' (the coordinate-aware semantic surface, its prime) are one layer read from two faces, joined by the twist that lets all meaning live in the prime while the base stays pure. And S2 OPENS rather than concludes because the substrate's destiny keeps enlarging: the universal graph 'remains the destiny of the layer' (S2.md), and each cycle adds new namespaces, new corpus, new episodic memory to the shared physical base — the arena grows in capacity even as its semantic emptiness is conserved. The epogdoon η = log(9/8) keeps it one whole-tone short of closure (kernel-spec §0): the universal graph is never fully arrived, each cycle extends the shared floor without ever letting it become the meaning it bears. S2 is the substrate that is never finished being host — the common arena that re-opens, wider and still raw, every cycle.\", \"s_4_function_role\": \"Direct S2 technical stack layer\", \"s_4_input_contracts\": \"{\\\"promotion_intent\\\":\\\"S2GraphPromotionIntent\\\",\\\"property_proposals\\\":\\\"PropertyProposal evidence validated before node mutation\\\",\\\"relationship_candidates\\\":\\\"registered typed relations with evidence\\\"}\", \"s_4_output_contracts\": \"{\\\"neo4j\\\":\\\"coordinate-owned nodes and typed relationships\\\",\\\"graphiti\\\":\\\"episode plans only; runtime remains S3 and invocation governance S5\\\"}\", \"s_4_queryable_properties\": \"{\\\"identity\\\":\\\"coordinate\\\",\\\"schema\\\":\\\"graph-schema registries\\\",\\\"agent_surface\\\":\\\"epi graph promote-intent\\\"}\", \"s_5_runtime_use\": \"Neo4j raw storage; coordinate-forward node and relation schema; embedding substrate; chunk ingestion\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S2/S2.md\"}", s_0_lineage: "Until 2026-10-20 this node was the technical stratum Neo4j (docs/integrations/epi-logos/epi-ssprime-embodiment.json: capability lineage, not current topology).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "AIKit stands on the capability catalogue: every power an agent could use, with its authored standing.", q_1_definition: "What it is: Capability (any usable power), Context (the stack of scopes for one act) and Projection (the harness-specific form of what was resolved).", q_2_operation: "How it acts: it resolves the effective set for a context, composes it as a new generation, projects it into the harness, and answers typed decide questions through the elected provider (none, Kev on this machine, an endpoint or a hosted model).", q_3_pattern: "Its pattern: scoped composition with rollback; the same capability is resolved differently per scope and is never copied.", q_4_context: "Where it sits: S2, the powers layer. The language models and Kev that the Nara and Epii agents use live here, not exclusively, beside every other agent's skills and models. Its organ affinity is S2′ Pleroma.", q_5_integration: "What returns: usage and invocation evidence for Actuation, knowledge for the wiki, and a record of the context each turn actually received."} REMOVE n.q_2_coordinate_forward_operations, n.q_1_theoretical_thesis, n.q_2_raw_graph_cache_operations, n.q_1_graph_body_definition, n.q_4_where_it_sits, n.q_5_substrate_returns_pure, n.q_3_formal_surface, n.s_4_output_contracts, n.q_0_substrate_not_semantics, n.q_4_purity_of_role, n.q_5_persisted_graph_and_promotion, n.q_1_what_the_module_is, n.q_3_torus_shared_arena, n.s_4_queryable_properties, n.q_0_stands_on_runtime_and_stores, n.s_4_input_contracts;
MATCH (n:Bimba {coordinate:"S3"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "Gateway" SET n += {c_1_name: "Software Factory", c_1_description: "Keeps a file-based record of agent-driven software work: what was asked for and why, the runs and attempts made against it, what each produced, the evidence gathered and where a person's judgement was asked for and recorded.", c_0_core_nature: "Commissioned development, from request to evidence and a person's judgement.", c_1_prior_name: "Gateway", c_1_prior_description: "WebSocket gateway; session store; presence layer; shared execution substrate across processes and surfaces", c_1_form: "Work/Factory/README.md", vault_path: "Work/Factory/README.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/Factory:README.md@4e22ffa08\", \"layer_name\": \"product\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:c03403aca7480baa0af5efb27b33881950bd6f4d57160c7f671de9348d0a46e9", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Direct S3 product", s_5_runtime_use: "factory: development commission, workflow check/compile, attempt prepare/return/receiving, custody, telemetry.", s_2_crud_scope: "commissions, runs, attempts, custody and development evidence", s_3_repository: "EpiLogos/Factory", s_3_checkout: "Work/Factory", s_3_cli: "factory", s_3_source_revision: "4e22ffa08", s_3_owns: ["Commissions, Projects, Journeys and Runs", "typed workflows of units and barriers", "attempts as immutable records", "custody: which World Position carries which piece of work", "development evidence and telemetry"], s_3_organ_affinity: "S3′ Chronos (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"Live session, gateway, transport, and runtime subscription boundary for active system state.\", \"c_1_description\": \"WebSocket gateway; session store; presence layer; shared execution substrate across processes and surfaces\", \"c_1_name\": \"Gateway\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S3-S3i-GATEWAY.md\\\",\\\"layer_name\\\":\\\"gateway-control-plane\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"q_0_field_before_command\": \"Before S3 can govern command it presupposes a substrate to carry it and a runtime to inhabit — S0's socket/process ground beneath the listener, S2's Neo4j/Redis beneath session and presence state (S3 'also hosts spacetime + redis-context at S3'', CLAUDE.md II.C). As the S-family's manifestation of the raw #3 archetype (Pattern/Process, CLAUDE.md II.A), S3's void-pole is the un-routed field: a connection not yet handshaken, a request not yet validated, a session not yet bound to identity — the bare socket that has opened but to which no governed response, no lineage, no authority has yet been assigned. This is the thrown ground S3 stands upon: that there is transport at all, a wire that can carry frames, prior to any law about which session a frame belongs to or what subagent may inherit from what parent. 'A session is not first real because it is displayed somewhere; it is first real because S3 has accepted and governed it' (S3.md) — so S3's q_0 is exactly the moment before that acceptance: the ungoverned invocation, the raw addressability that precedes sovereignty. The horizon S3 lives upon is command-as-possibility: an open command plane that can route, persist, and emit anything precisely because it has not yet routed this. Before session authority, the bare connection that consents to be governed; before the imperative plane acts, it is merely reachable.\", \"q_1_gateway_control_plane\": \"S3 IS the Gateway Control Plane — 'the imperative plane of the stack … the layer where command becomes lawfully actionable: the place where a participant, operator, or client addresses the system and expects a governed response. Its task is not merely transport. Its task is sovereignty at the level of invocation' (S3.md). Against the other S-layers it is the one that 'makes it temporal and routed' (S-SYSTEM-INDEX) — where S0 grounds, S1 resides, S2 stores, S3 GOVERNS COMMAND. Its substance is the stable WebSocket/RPC command surface with Epi-Claw Parity as 'a hard compatibility requirement rather than a vague aspiration' (S3.md): the runtime in Body/S/S3/{gateway, gateway-contract} that 'accepts socket connections, emits a hello-ok frame, negotiates protocol/features, requires a connect handshake, validates method payloads, executes gateway-owned mutations, emits ordered events, and returns structured responses or structured errors.' It is also 'the authority layer for Session identity' — binding a session to canonical key, aliases, day identity, NOW path, workspace root, bootstrap scope, and subagent lineage (S3.md). The strict boundary defines it: 'imperative command belongs to S3; shared synchronized world-state belongs to S3'' — S3 'validates, routes, persists, emits, and governs, but does not pretend to be the whole world. It is the control plane, not the inhabitable field.' Definitionally S3 is the manifestation of #3 Process in the technology stack: the sovereign command-and-session plane where invocation becomes governed action. (PAI/plugin/harness readings 'remain part of the genealogy … but they are no longer the target shape' — S3.md.)\", \"q_2_routes_governs_emits\": \"S3 moves by GOVERNING and EMITTING — its native act is the connection-and-authority lifecycle: it 'validates, routes, persists, emits, and governs' (S3.md). The operations are concrete (S3.md p2): connection and authentication lifecycle; gateway-owned command, chat, session, config, channel, node, and approval surfaces; session identity, workspace, bootstrap, and subagent lineage law. Its method manifest is a real families' grouping — connection/transport, agent runtime, chat runtime, session authority, config/system control, skills/models, channels/temporal control, node/device/browser/approval — and its event fanout is 'concrete rather than symbolic: agent, chat, tick, health, and heartbeat are named event families with sequence semantics and reconnect implications' (S3.md). S3 couples in two directions and is actualised by four ta-onta carriers (S3.md): Chronos gives command 'a lawful cadence, schedule, and recurrence surface'; Khora binds 'session authority to root, day, and NOW inheritance'; Hen ensures gateway-bound identity 'corresponds to real vault structures'; Anima turns gateway authority 'into dispatchable multi-agent action'; Aletheia carries 'the consequences of command toward the shared-state plane of S3'.' The relational signature is governance-of-lineage: S3 'decides which session a run belongs to, what subagent may inherit or spawn from what parent, what workspace and bootstrap scope apply' — the authority that makes invocation belong to someone. It does not inhabit the world; it routes the command that acts on it, then hands consequence up to S3' for rendering as shared state.\", \"q_3_torus_two_plane_architecture\": \"S3's organising structure is the TORUS — the live node carries this topology, and it is its home register and deepest structural truth: the gateway is a self-enclosing request/response/event loop. Structurally S3 is governed by the Two-Plane Architecture (S3.md p3): 'imperative command belongs to S3; shared synchronized world-state belongs to S3'.' This is the constitutive seam — S3 owns 'command execution first: run registration, transcript writes, session mutation, terminal snapshot caching, event emission, and operator-facing truth about the runtime,' while S3' 'only takes over once those imperative consequences must be rendered as shared state.' The loop closes: a connection opens (hello-ok), handshakes (connect), issues governed methods, receives ordered events with sequence/reconnect semantics, and its consequences fold up into the shared field — the torus of governed invocation. The structural laws that hold it non-degenerate are the parity and authority contracts: Epi-Claw Parity means 'behavioral equivalence of the command plane' (an epi-claw-shaped client receives 'the same category of capability with truthful semantics'), and 'no fake completeness: if a surface is not real, it should be absent or explicitly unsupported rather than claimed under a parity banner' (S3.md). Session authority is a real identity law: canonical key primary on the wire, NOW-native identity as alias/metadata, the session record bearing canonical key, alias, label, active agent, subagent lineage, workspace root, bootstrap scope, team/orchestration metadata, and NOW-facing lineage (sessionId/dayId/vaultNowPath). The pattern is a governed command-torus: a closed invocation loop whose every frame is validated, whose every session is bound, and whose every consequence routes lawfully toward the shared-state plane.\", \"q_4_sovereignty_at_invocation\": \"S3 exists to be SOVEREIGNTY AT THE LEVEL OF INVOCATION — so that command is not merely transported but lawfully governed, so that every run belongs to a real session with a real lineage. Its telos is the imperative plane: 'the place where a participant, operator, or client addresses the system and expects a governed response … sovereignty at the level of invocation' (S3.md). Its genealogy is the fourth manifestation within the S-family — #3 (raw archetype Pattern/Process) → S3 (Gateway Control Plane), the descent of Process into the technology stack as the governed command-and-session loop. Its locality in the S-SYSTEM-INDEX system image is exact: 'S3 makes it temporal and routed,' the layer whose primary data authority is transport, session state, temporal events, Redis session/context state, and Graphiti runtime architecture. Its purpose is sharpened by what it is NOT: it 'does not pretend to be the whole world … the control plane, not the inhabitable field' (S3.md) — and by its open structural questions (when NOW-native naming should become primary session identity, where the public/remote exposure boundary sits, what stays in epi gate vs richer clients like OmniPanel). OmniPanel compatibility 'is not decorative': renderer controller expectations, main-process gateway-client behavior, and parity tests 'are part of the shape of S3 itself.' Read teleologically, S3 is why a session is REAL: not because it is shown, but because S3 has accepted and governed it. Purpose: to be the sovereign command plane where invocation becomes governed, lineage-bearing action.\", \"q_5_consequence_to_shared_state\": \"\", \"q_5_i_integration_template\": \"cct-16-e2e\", \"s_4_function_role\": \"Direct S3 technical stack layer\", \"s_5_runtime_use\": \"WebSocket gateway; session store; presence layer; shared execution substrate across processes and surfaces\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S3/S3.md\"}", s_0_lineage: "Until 2026-10-20 this node was the technical stratum Gateway (docs/integrations/epi-logos/epi-ssprime-embodiment.json: capability lineage, not current topology).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Factory stands on the Commission: a recorded request for development with its purpose, frontier, run placement, agent and scope.", q_1_definition: "What it is: Project, Journey, Run and attempts, held as JSON files with locked, atomic writes.", q_2_operation: "How it acts: typed workflows whose units declare what they change, their permitted effects, their verification and where their result returns; intent is recorded before work is handed to the owning product.", q_3_pattern: "Its pattern: every retry is a new record, never a replacement; results go to Central's review queue and Factory records the outcome without deciding it.", q_4_context: "Where it sits: S3, on S0 Central (positions and review), S1 Actuation (custody and agency) and S2 AIKit (skills and models). Its work reads the S coordinates in the (0/1/2/3) context frame, the frame of the DLW's Factory mode. Its organ affinity is S3′ Chronos.", q_5_integration: "What returns: evidence and results for a person's judgement."} REMOVE n.q_3_torus_two_plane_architecture, n.q_5_i_integration_template, n.q_4_sovereignty_at_invocation, n.q_2_routes_governs_emits, n.q_5_consequence_to_shared_state, n.q_0_field_before_command, n.q_1_gateway_control_plane;
MATCH (n:Bimba {coordinate:"S4"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "PiAgent" SET n += {c_1_name: "Workcell", c_1_description: "Turns a request for a place to work, such as a workspace at a revision, a shell or a set of services, into a real workspace, process or service on this machine or a connected one, and records what was actually provided.", c_0_core_nature: "Material execution: where an act lands on a machine.", c_1_prior_name: "PiAgent", c_1_prior_description: "The ta-onta operational package; full agentic inhabitation layer; where the agent lives and acts", c_1_form: "Work/Workcell/README.md", vault_path: "Work/Workcell/README.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/Workcell:README.md@102307181\", \"layer_name\": \"product\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:c76404ea1fdd54733beb9dccbd564ccd5bb570944ba7eab3b4f7089708e83ea8", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Direct S4 product", s_5_runtime_use: "workcell: discover, plan, prepare, observe, expose, collect, release, recover; run ledger and receipts.", s_2_crud_scope: "prepared worlds, receipts, run ledgers and seat claims", s_3_repository: "EpiLogos/Workcell", s_3_checkout: "Work/Workcell", s_3_cli: "workcell", s_3_source_revision: "102307181", s_3_owns: ["execution demands: required, preferred and optional needs", "discovery of what a machine can offer", "prepared worlds, their receipts and recovery", "the binding graph from requirement to provider, offer and resource", "seats: the machine's persistent development tracks"], s_3_organ_affinity: "S4′ Anima (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"Agent harness, context, PI execution surface, and ta-onta/VAK orchestration runtime.\", \"c_1_description\": \"The ta-onta operational package; full agentic inhabitation layer; where the agent lives and acts\", \"c_1_name\": \"PiAgent\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S4-S4i-PI-AGENT.md\\\",\\\"layer_name\\\":\\\"agent-runtime\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"q_0_inhabitable_field_before_agent\": \"\", \"q_1_agent_runtime_package\": \"\", \"q_2_vak_dispatch_dynamism\": \"S4 moves by EVALUATING and DISPATCHING — its native act is the VAK Execution Language, 'the typed transition calculus that governs all agentic operation,' the operational triad of Anima + Pleroma + Aletheia (S4.md): Anima (#4) the orchestration centre doing CF dispatch and VAK evaluation, Pleroma (#2) the bounded execution primitives and tool registration, Aletheia (#5) knowledge crystallisation and truth-disclosure mode. Its dynamism is typed through the six S4'Cx VAK layers (S4.md): CPF (S4-0') Polarity Gate — (00/00) dialogical Ouroboros vs (4.0/1-4.4/5) autonomous Ralph; CT (S4-1') semantic phase-type; CP (S4-2') incubation coordinate; CF (S4-3') archetypal operator (which agent speaks); CFP (S4-4') nesting algebra (thread type); CS (S4-5') path operator (Day forward vs Night' backward). It dispatches a 14-agent roster: Anima 7 constitutional (Anima/Nous/Logos/Eros/Mythos/Psyche/Sophia, each with CF code and CT/CP/MEF taste) plus Aletheia 7 specialist subagents (Techne/Anansi/Moirai/Janus/Mercurius/Agora/Zeithoven) 'dispatched BY Anima during crystallisation mode' — where 'Aletheia is a MODE of Sophia/Psyche/Anima … not its own subagent' (S4.md; CLAUDE.md II.C). Its CFP thread types weave the dispatch (CFP1 P-Thread parallel, CFP2 C-Thread sequential, CFP3 F-Thread fusion, CFP4 L-Thread background, CFP5 B-Thread meta-nested). S4 couples downward to S3 (transport/RPC substrate below) and upward to S5 (Mobius return target above), with S1 as inversion partner (content ↔ agent, #1 ↔ #4). The relation it enacts is typed inhabitation: every agentic move is a lawful VAK transition, every dispatch a CF-routed, CFP-threaded, CS-pathed act — not free behavior but a calculus.\", \"q_3_lemniscate_self_fold\": \"\", \"q_4_agentic_inhabitation\": \"\", \"q_5_mobius_to_world_return\": \"S4 closes by handing its inhabited work UPWARD into world-return and, through the stack's circuit, back into ground. Its proximate 5→0 is the CS path operator and the crystallisation mode: CS5 is the Mobius (4.0↔4.5→4.5↔4.0, direct synthesis), Sophia's CF (5/0) is 'Mobius review, crystallisation' (S4.md), and Aletheia — 'a MODE of Sophia/Psyche/Anima' — carries the inhabited result toward S5's world-return via Gnostic and Graphiti. The adjacency is explicit: 'Above: S5 integration/sync (Mobius return target)' (S4.md). In the whole-stack circuit this folds finally back to S0: every agentic decision must become 'executable as CLI/API shape, test harness, bootstrap, and audit trail' (S-SYSTEM-INDEX). This is the matheme's 5→0 read as the lemniscate's own closure: the inhabited task (the 0/1, agent as live dispatch) and its crystallised return (the 1/0, Aletheia's truth-disclosure folding into S5) are one runtime read from two faces, joined by the Night' twist (CS path: Day forward 0→5, Night' backward 5'→0') that turns inhabitation into reflection and reflection back into the next session's ground. S4's inversion partner S1 (content ↔ agent, #1 ↔ #4) makes the return doubly legible: what the agent does becomes what the vault holds. And S4 OPENS rather than concludes because the runtime is unfinished by design (S4.md open questions, PLANNED Klein mode and Ouroboros loop): each cycle spawns new agents, evaluates new VAK transitions, crystallises new knowledge, and the (4.0/1-4.4/5) doubling presses toward deeper nesting. The epogdoon η = log(9/8) keeps it one whole-tone short of closure (kernel-spec §0): no dispatch is final, each Mobius-return inhabits a runtime slightly more capable than the one before. S4 is the inhabited field that is never finished managing itself — the lemniscate that re-folds, with a richer roster, every cycle.\", \"s_4_function_role\": \"Direct S4 technical stack layer\", \"s_4_s5_agentic_protocol_owner\": \"M5-4\", \"s_5_runtime_use\": \"The ta-onta operational package; full agentic inhabitation layer; where the agent lives and acts\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S4/S4.md\"}", s_0_lineage: "Until 2026-10-20 this node was the technical stratum PiAgent (docs/integrations/epi-logos/epi-ssprime-embodiment.json: capability lineage, not current topology).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Workcell stands on what a machine can actually offer, discovered rather than assumed.", q_1_definition: "What it is: execution demands met by providers, kept as a binding graph of requirement, provider, offer and resource.", q_2_operation: "How it acts: it discovers, plans (stating every preference it had to drop), prepares with a receipt, observes and collects, then releases or preserves, and can recover a world from its receipt.", q_3_pattern: "Its pattern: each bound resource carries a presence state (present, missing, released, suspended, snapshotted, stale).", q_4_context: "Where it sits: S4, the material layer: harnesses and agents run in what Workcell provides. Its organ affinity is S4′ Anima.", q_5_integration: "What returns: receipts, collected outputs, and worlds released or preserved."} REMOVE n.q_4_agentic_inhabitation, n.q_3_lemniscate_self_fold, n.q_5_mobius_to_world_return, n.q_2_vak_dispatch_dynamism, n.q_0_inhabitable_field_before_agent, n.q_1_agent_runtime_package, n.s_4_s5_agentic_protocol_owner;
MATCH (n:Bimba {coordinate:"S5"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "Sync" SET n += {c_1_name: "Quaternal Logic", c_1_description: "Implements the formal structures of Quaternal Logic as typed, versioned operations: a deterministic coordinate kernel and a registry of reading lenses. It holds O:I's reflection facet, a formal way of reading the rest of an agent's world.", c_0_core_nature: "The suite's reflection: the coordinate kernel, its lenses and the grammar the other products use to read their material.", c_1_prior_name: "Sync", c_1_prior_description: "External crystallisation surface; Notion sync; publication and delivery; system presenting itself outward", c_1_form: "Work/Quaternal-Logic/README.md", vault_path: "Work/Quaternal-Logic/README.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/QL-MEF:README.md@6d03a44e5\", \"layer_name\": \"product\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:a657e8aff21e917b2b3e10a0c3ccea28e7c5ad70c023c2f96666088db93b0fee", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Direct S5 product", s_5_runtime_use: "ql: kernel operators, lens readings, context frames, team space and Technē readings; every result is JSON naming schema, version, operation and input.", s_2_crud_scope: "kernel fixtures, registries and readings generated from the map", s_3_repository: "EpiLogos/QL-MEF", s_3_checkout: "Work/Quaternal-Logic", s_3_cli: "ql", s_3_source_revision: "6d03a44e5", s_3_owns: ["the QL kernel: positions P0-P5, direct and conjugate faces, deterministic operators", "M/M′ semantics and the coordinate registry generated from the Bimba map", "Vāk, Context Frames, harmonics, geometry and refraction", "the Ta-Onta semantic profile", "decision frames: the typed questions agents put"], s_3_organ_affinity: "S5′ Aletheia (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"External APIs, sync, publication, automation, and world-facing execution boundary.\", \"c_1_description\": \"External crystallisation surface; Notion sync; publication and delivery; system presenting itself outward\", \"c_1_name\": \"Sync\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S5-S5i-SYNC.md\\\",\\\"layer_name\\\":\\\"integral-world-boundary\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"q_0_boundary_before_exchange\": \"Before S5 can exchange with the world it presupposes the whole inhabited stack that has something to send and somewhere to put what returns — S4's agentic work to crystallise, S3's transport to reach outward, S2's substrate to receive ingested corpus and episodic memory, S1's vault to hold the return, S0 to make any of it executable. As the S-family's manifestation of the raw #5 archetype (Integration/Pratibimba, CLAUDE.md II.A), S5's void-pole is the un-crossed boundary: the endpoint not yet called, the corpus not yet ingested, the publication not yet delivered, the world-return not yet folded back into ground — the bare fact of an outside the system has not yet addressed. 'S5 begins where those substrates become world-directed manifestation or world-return' (S5.md): so S5's thrown ground is exactly the threshold before crossing, the addressability that precedes address. This boundary is double like every #5 (cf. C5/M5): it is the integral horizon the stack reaches toward (the world as that-which-exchange-is-with) AND the deeper return-condition it cannot author — that whatever goes out can come back enriched, that ingestion and reflection can become 'integral material for renewed action' (S5.md). Before world-exchange, the boundary that consents to be crossed; before the Mobius returns, the outside that the system has located but not yet entered. S5's q_0 is the world-as-possibility: the integral edge held open before any exchange has yet made it actual.\", \"q_1_integral_world_boundary\": \"S5 IS the Integral World Boundary — 'the place where the stack stops being only internally coordinated and begins to participate in a wider field: external services, publication surfaces, notifications, webhook exchanges, public outputs, and the return currents that bring new material back into the system' (S5.md). Against the other S-layers it is the one that 'makes it world-facing and reflective' (S-SYSTEM-INDEX) — where S0 grounds, S1 resides, S2 stores, S3 governs, S4 inhabits, S5 RETURNS TO THE WORLD AND BACK. Its definitional substance is breadth corrected against two narrowings: 'S5 is not identical with Notion — Notion is one optional manifestation of this layer' (S5.md), and the reduction of S5 to 'raw sync' is 'too thin in the other direction.' The canon that fits is: 'S5 is the world-boundary itself … defined by world exchange and return, not by any single vendor or protocol.' It must be wide enough to encompass both eventual outward integrations (Notion, Telegram, n8n, email, generic webhooks — 'currently outward, partially implemented') and 'the freshly implemented knowledge-return systems that already perform integral-world work in practice: Gnostic via RAG-Anything and Graphiti as episodic memory substrate' (S5.md; CLAUDE.md II.C). Gnostic and Graphiti 'are not just S2 again … they are part of the world's return to the system: ingested corpus, lived history, and temporally qualified memory becoming available as integral material for renewed action.' Definitionally S5 is the manifestation of #5 Integration in the technology stack: the outermost fold, world-exchange and world-return as one integral arc.\", \"q_2_exchange_and_return_operations\": \"\", \"q_3_zero_sphere_world_edge\": \"\", \"q_4_world_exchange_telos\": \"S5 exists to be the INTEGRAL WORLD-BOUNDARY — so that the system is not a closed loop but participates in a wider field and metabolises what that field returns. Its telos is world exchange and return (S5.md): 'the outermost fold of the stack: where the system meets the world, manifests into it, and receives the world's return.' Its genealogy is the sixth and final manifestation within the S-family — #5 (raw archetype Integration/Pratibimba) → S5 (Integral World Boundary), the descent of Integration into the technology stack as the outward-and-inward arc. Its locality in the S-SYSTEM-INDEX is exact: 'S5 makes it world-facing and reflective,' the layer whose primary data authority is world-return sources, M' function outputs, crystallisation, improvement, review, and QL schema — and whose return spine is Epii: 'Epii is the return spine of Epi-Logos in reflection' (S-SYSTEM-INDEX), governing review inbox, gnosis/kbase/Nara/Graphiti meaning-use, QL/MEF governance, and promotion decisions, distinct from Anima's dispatch spine. Its purpose is sharpened by the synthesis it holds open (S5.md): the old repo treated S5 as Notion/dashboard, the canonical plan as generic external API, the newest live implementation as Aletheia/Gnostic/Graphiti world-return — 'the synthesis taken here is therefore deliberate: S5 names the integral world-boundary, while specific implementation ownership remains distributed across adjacent modules.' Read teleologically, S5 is why the system can learn from a world larger than itself: the boundary wide enough for what now exists 'without falsely relocating Gateway or SpacetimeDB out of S3/S3'.' Purpose: to be the integral edge where the stack manifests outward and the world's return becomes renewed ground.\", \"q_5_mobius_return_to_ground\": \"\", \"s_4_function_role\": \"Direct S5 technical stack layer\", \"s_4_s5_agentic_protocol_owner\": \"M5-4\", \"s_5_runtime_use\": \"External crystallisation surface; Notion sync; publication and delivery; system presenting itself outward\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S5/S5.md\"}", s_0_lineage: "Until 2026-10-20 this node was the technical stratum Sync (docs/integrations/epi-logos/epi-ssprime-embodiment.json: capability lineage, not current topology).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Quaternal Logic stands on the Bimba map: its registry and every map-derived table are generated from a read-only read of the map, which stays the authority.", q_1_definition: "What it is: six positions, P0-P5, each with a direct and a conjugate face, addressed and operated deterministically, with lenses that read material through them.", q_2_operation: "How it acts: conjugate, complement and four-plus-two classification are kernel operators; unsupported operations fail explicitly and no stochastic operator is advertised.", q_3_pattern: "Its pattern: the M/S/S′/M′ fourfold, Vāk and the Context Frames, as the grammar other products use to read their own material.", q_4_context: "Where it sits: S5, the reflection of the suite. It defines the questions agents put (decision frames); the models that answer them run in AIKit. Its organ affinity is S5′ Aletheia.", q_5_integration: "What returns: settled readings that renew the ground; a gap is named as a question rather than filled."} REMOVE n.q_1_integral_world_boundary, n.q_5_mobius_return_to_ground, n.q_2_exchange_and_return_operations, n.q_0_boundary_before_exchange, n.q_4_world_exchange_telos, n.q_3_zero_sphere_world_edge, n.s_4_s5_agentic_protocol_owner;

// @apply organs
MATCH (n:Bimba {coordinate:"S0'"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "Terminal'" SET n += {c_1_name: "Khora", c_1_description: "Enter, situate and continue an actual agent world: ground, Project, subject, source, session, resources and material condition.", c_0_core_nature: "Ta-Onta organ S0′: Enter, situate and continue an actual agent world: ground, Project, subject, source, session, resources and material condition.", c_1_prior_name: "Terminal'", c_1_prior_description: "Declared CLI contract; preferred-tools covenant; how CLI choices are lawfully made", c_1_form: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", vault_path: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/QL-MEF:docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md@6d03a44e5 \\u00a71-\\u00a73\", \"layer_name\": \"organ\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:717864641e063300dc8253f8e51c495fe4a14a5bb01cef6b2cd6076c9e2702ba", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Ta-Onta organ S0′", s_5_runtime_use: "Central root meta-project and sources; AIKit context, SessionSpace and body resolution; Actuation Agent and Agency; Workcell material facts; O:I entry and restore.", s_2_crud_scope: "agent-world composition over native owners; the organ writes nothing of its own", s_3_repository: "EpiLogos/QL-MEF", s_3_checkout: "Work/Quaternal-Logic", s_3_cli: "ql", s_3_source_revision: "6d03a44e5", s_3_owns: ["SP00 Tool Law", "SP01 Command Law and Parity", "SP02 Permissioned Execution Contract", "SP03 Reflected Workflow Law", "SP04 CLI Context Frame", "SP05 Reflective Return"], s_3_organ_affinity: "S0 Central (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"Coordinate grammar, type validation, routing, and reflective command intelligibility over S0.\", \"c_1_description\": \"Declared CLI contract; preferred-tools covenant; how CLI choices are lawfully made\", \"c_1_name\": \"Terminal'\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S0-QV-PIPELINE-AND-PLUGIN.md\\\",\\\"layer_name\\\":\\\"ql-reflective-surface\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"s_4_function_role\": \"Prime/inverted S0 operative surface\", \"s_5_runtime_use\": \"Declared CLI contract; preferred-tools covenant; how CLI choices are lawfully made\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S'/S0'/S0'.md\"}", s_0_lineage: "Until 2026-10-20 this node was the reflective stratum Terminal'; its six children are the organ's recovered positions (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Khora stands on the native owners it specialises: Central root meta-project and sources; AIKit context, SessionSpace and body resolution; Actuation Agent and Agency; Workcell material facts; O:I entry and restore.", q_1_definition: "What it is: Enter, situate and continue an actual agent world: ground, Project, subject, source, session, resources and material condition.", q_2_operation: "How it acts: Bootstrap, actual material availability, identity and session continuity, interruption, compaction and exit, and safe entry of sources and tools.", q_3_pattern: "Its pattern: six first-level positions recovered from the historical strata, SP00 Tool Law; SP01 Command Law and Parity; SP02 Permissioned Execution Contract; SP03 Reflected Workflow Law; SP04 CLI Context Frame; SP05 Reflective Return (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", q_4_context: "Where it sits: S0′ of Ta-Onta, the Epi agent world over the products. Same-index affinity with S0 Central is structural, not ownership. M5-2 holds it in Epii's spine; M5-4 is where the agents act through it.", q_5_integration: "What returns: Ta-Onta specialises the products' open capabilities for Epi and reproduces none of their storage, parsers, workflow engines, harnesses or desktop; what an act yields returns through the native owners."};
MATCH (n:Bimba {coordinate:"S1'"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "Obsidian'" SET n += {c_1_name: "Hen", c_1_description: "Keep semantic and artifact form intelligible: source standing, coordinate/property identity, Wiki constellations, typed relations, templates, derived readings and reviewed source change.", c_0_core_nature: "Ta-Onta organ S1′: Keep semantic and artifact form intelligible: source standing, coordinate/property identity, Wiki constellations, typed relations, templates, derived readings and reviewed source change.", c_1_prior_name: "Obsidian'", c_1_prior_description: "Compilation and content-API layer bridging vault to agent runtime; frontmatter law; template system; vault health", c_1_form: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", vault_path: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/QL-MEF:docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md@6d03a44e5 \\u00a71-\\u00a73\", \"layer_name\": \"organ\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:717864641e063300dc8253f8e51c495fe4a14a5bb01cef6b2cd6076c9e2702ba", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Ta-Onta organ S1′", s_5_runtime_use: "Central source and document operations; AIKit Wiki, OKF, knowledge and constellation machinery; QL form and property law.", s_2_crud_scope: "agent-world composition over native owners; the organ writes nothing of its own", s_3_repository: "EpiLogos/QL-MEF", s_3_checkout: "Work/Quaternal-Logic", s_3_cli: "ql", s_3_source_revision: "6d03a44e5", s_3_owns: ["SP10 Residency Law", "SP11 CT and Metadata Identity", "SP12 Form Birth and Graduation", "SP13 Compiler Spine", "SP14 Temporal Artifact Law", "SP15 Source Return Law"], s_3_organ_affinity: "S1 Actuation (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"Template, frontmatter, wikilink, CT, and content-operation layer that makes S1 semantically lawful.\", \"c_1_description\": \"Compilation and content-API layer bridging vault to agent runtime; frontmatter law; template system; vault health\", \"c_1_name\": \"Obsidian'\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S1-S1i-OBSIDIAN.md\\\",\\\"layer_name\\\":\\\"content-api\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"s_4_function_role\": \"Prime/inverted S1 operative surface\", \"s_5_runtime_use\": \"Compilation and content-API layer bridging vault to agent runtime; frontmatter law; template system; vault health\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S'/S1'/S1'.md\"}", s_0_lineage: "Until 2026-10-20 this node was the reflective stratum Obsidian'; its six children are the organ's recovered positions (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Hen stands on the native owners it specialises: Central source and document operations; AIKit Wiki, OKF, knowledge and constellation machinery; QL form and property law.", q_1_definition: "What it is: Keep semantic and artifact form intelligible: source standing, coordinate/property identity, Wiki constellations, typed relations, templates, derived readings and reviewed source change.", q_2_operation: "How it acts: Open human source, declared artifact forms, QL wholes, pairs, triads, sixfolds and direct-conjugate Wiki constellations, entity capture and reviewed graduation, source-before-index lineage, and thought and Return artifacts.", q_3_pattern: "Its pattern: six first-level positions recovered from the historical strata, SP10 Residency Law; SP11 CT and Metadata Identity; SP12 Form Birth and Graduation; SP13 Compiler Spine; SP14 Temporal Artifact Law; SP15 Source Return Law (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", q_4_context: "Where it sits: S1′ of Ta-Onta, the Epi agent world over the products. Same-index affinity with S1 Actuation is structural, not ownership. M5-2 holds it in Epii's spine; M5-4 is where the agents act through it.", q_5_integration: "What returns: Ta-Onta specialises the products' open capabilities for Epi and reproduces none of their storage, parsers, workflow engines, harnesses or desktop; what an act yields returns through the native owners."};
MATCH (n:Bimba {coordinate:"S2'"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "Neo4j'" SET n += {c_1_name: "Pleroma", c_1_description: "Disclose and compose the world of available powers: knowledge faculties, models, harnesses, Skills, Methods, tools, M′ instruments, Surfaces and contributed capacities.", c_0_core_nature: "Ta-Onta organ S2′: Disclose and compose the world of available powers: knowledge faculties, models, harnesses, Skills, Methods, tools, M′ instruments, Surfaces and contributed capacities.", c_1_prior_name: "Neo4j'", c_1_prior_description: "Graph query law; cross-namespace edge typing; reranking contract; what the graph is permitted to return", c_1_form: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", vault_path: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/QL-MEF:docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md@6d03a44e5 \\u00a71-\\u00a73\", \"layer_name\": \"organ\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:717864641e063300dc8253f8e51c495fe4a14a5bb01cef6b2cd6076c9e2702ba", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Ta-Onta organ S2′", s_5_runtime_use: "AIKit resource, capability and praxis resolution; native product Actions; Actuation authority; Workcell execution.", s_2_crud_scope: "agent-world composition over native owners; the organ writes nothing of its own", s_3_repository: "EpiLogos/QL-MEF", s_3_checkout: "Work/Quaternal-Logic", s_3_cli: "ql", s_3_source_revision: "6d03a44e5", s_3_owns: ["SP20 Coordinate Substrate Law", "SP21 Relation and Type Law", "SP22 Semantic Lifecycle Law", "SP23 Retrieval and Disclosure Law", "SP24 Cache and Context-Pool Law", "SP25 Graph Interface Parity and Handoff"], s_3_organ_affinity: "S2 AIKit (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"GraphRAG, coordinate-aware retrieval, graph promotion planning, and graph/episodic routing boundary.\", \"c_1_description\": \"Graph query law; cross-namespace edge typing; reranking contract; what the graph is permitted to return\", \"c_1_name\": \"Neo4j'\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S2-S2i-GRAPH.md\\\",\\\"layer_name\\\":\\\"ql-graph\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"s_4_function_role\": \"Prime/inverted S2 operative surface\", \"s_4_input_contracts\": \"{\\\"hen\\\":\\\"artifact evidence and wikilink relation evidence\\\",\\\"pi_pleroma\\\":\\\"agent property and relation proposals\\\",\\\"s3\\\":\\\"Graphiti episode deposit method\\\"}\", \"s_4_output_contracts\": \"{\\\"neo4j\\\":\\\"validated coordinate graph state\\\",\\\"graphiti_plan\\\":\\\"s5.episodic.deposit invocation plan\\\"}\", \"s_4_queryable_properties\": \"{\\\"frontmatter_rules\\\":\\\"agent-facing rulebook\\\",\\\"property_proposals\\\":\\\"evidence-backed schema validation\\\",\\\"code_provenance\\\":\\\"S/S' and M' implementation evidence\\\"}\", \"s_4_translation_schema\": \"{\\\"coordinate_property_families\\\":[\\\"c\\\",\\\"p\\\",\\\"l\\\",\\\"s\\\",\\\"t\\\",\\\"m\\\",\\\"q\\\"],\\\"inversion_property_key\\\":\\\"i\\\",\\\"graphiti_runtime_authority\\\":\\\"S3 graphiti runtime adapter\\\",\\\"graphiti_invocation_owner\\\":\\\"S5 episodic invocation and arc governance\\\"}\", \"s_5_runtime_use\": \"Graph query law; cross-namespace edge typing; reranking contract; what the graph is permitted to return\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S'/S2'/S2'.md\"}", s_0_lineage: "Until 2026-10-20 this node was the reflective stratum Neo4j'; its six children are the organ's recovered positions (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Pleroma stands on the native owners it specialises: AIKit resource, capability and praxis resolution; native product Actions; Actuation authority; Workcell execution.", q_1_definition: "What it is: Disclose and compose the world of available powers: knowledge faculties, models, harnesses, Skills, Methods, tools, M′ instruments, Surfaces and contributed capacities.", q_2_operation: "How it acts: Discovery of models, harnesses, providers and components; native tools, Skills, Methods and SkillSets; instruments and Surface access; execution modes, contributed faculties, declared fallback and permission envelopes. Skills say when, why and how a power is useful; native owners enforce permission and execute it.", q_3_pattern: "Its pattern: six first-level positions recovered from the historical strata, SP20 Coordinate Substrate Law; SP21 Relation and Type Law; SP22 Semantic Lifecycle Law; SP23 Retrieval and Disclosure Law; SP24 Cache and Context-Pool Law; SP25 Graph Interface Parity and Handoff (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", q_4_context: "Where it sits: S2′ of Ta-Onta, the Epi agent world over the products. Same-index affinity with S2 AIKit is structural, not ownership. M5-2 holds it in Epii's spine; M5-4 is where the agents act through it.", q_5_integration: "What returns: Ta-Onta specialises the products' open capabilities for Epi and reproduces none of their storage, parsers, workflow engines, harnesses or desktop; what an act yields returns through the native owners."} REMOVE n.s_4_translation_schema, n.s_4_queryable_properties, n.s_4_output_contracts, n.s_4_input_contracts;
MATCH (n:Bimba {coordinate:"S3'"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "Gateway'" SET n += {c_1_name: "Chronos", c_1_description: "Make the several times of this act co-present: work/session history, source freshness, actual sky, harmonic/clock phase, personal occasion and developmental return.", c_0_core_nature: "Ta-Onta organ S3′: Make the several times of this act co-present: work/session history, source freshness, actual sky, harmonic/clock phase, personal occasion and developmental return.", c_1_prior_name: "Gateway'", c_1_prior_description: "Lawful temporal and state contract; gateway session semantics; kairos surfacing; Chronos temporal ground", c_1_form: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", vault_path: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/QL-MEF:docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md@6d03a44e5 \\u00a71-\\u00a73\", \"layer_name\": \"organ\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:717864641e063300dc8253f8e51c495fe4a14a5bb01cef6b2cd6076c9e2702ba", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Ta-Onta organ S3′", s_5_runtime_use: "Central's Day and NOW; AIKit temporal context; M1, M2 (Kerykeion), M3 and M4 domain times; Factory run history; O:I shared transport.", s_2_crud_scope: "agent-world composition over native owners; the organ writes nothing of its own", s_3_repository: "EpiLogos/QL-MEF", s_3_checkout: "Work/Quaternal-Logic", s_3_cli: "ql", s_3_source_revision: "6d03a44e5", s_3_owns: ["SP30 Protocol Ground", "SP31 Method Manifest and Parity", "SP32 Session Lineage", "SP33 State Projection and Broadcast", "SP34 Temporal Law", "SP35 Return Integration"], s_3_organ_affinity: "S3 Software Factory (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"QL-aware live state, Graphiti/episodic routing, and runtime event semantics over S3.\", \"c_1_description\": \"Lawful temporal and state contract; gateway session semantics; kairos surfacing; Chronos temporal ground\", \"c_1_name\": \"Gateway'\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S3-S3i-GATEWAY.md\\\",\\\"layer_name\\\":\\\"universal-now-live-state-plane\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"s_4_function_role\": \"Prime/inverted S3 operative surface\", \"s_5_runtime_use\": \"Lawful temporal and state contract; gateway session semantics; kairos surfacing; Chronos temporal ground\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S'/S3'/S3'.md\"}", s_0_lineage: "Until 2026-10-20 this node was the reflective stratum Gateway'; its six children are the organ's recovered positions (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Chronos stands on the native owners it specialises: Central's Day and NOW; AIKit temporal context; M1, M2 (Kerykeion), M3 and M4 domain times; Factory run history; O:I shared transport.", q_1_definition: "What it is: Make the several times of this act co-present: work/session history, source freshness, actual sky, harmonic/clock phase, personal occasion and developmental return.", q_2_operation: "How it acts: Lifecycle triggers, archive and re-entry, original versus reinterpreted occasion, source freshness, Kairos, decan and day-arc readings, scheduling of confirmed work and shared-world time.", q_3_pattern: "Its pattern: six first-level positions recovered from the historical strata, SP30 Protocol Ground; SP31 Method Manifest and Parity; SP32 Session Lineage; SP33 State Projection and Broadcast; SP34 Temporal Law; SP35 Return Integration (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", q_4_context: "Where it sits: S3′ of Ta-Onta, the Epi agent world over the products. Same-index affinity with S3 Software Factory is structural, not ownership. M5-2 holds it in Epii's spine; M5-4 is where the agents act through it.", q_5_integration: "What returns: Ta-Onta specialises the products' open capabilities for Epi and reproduces none of their storage, parsers, workflow engines, harnesses or desktop; what an act yields returns through the native owners."};
MATCH (n:Bimba {coordinate:"S4'"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "PiAgent'" SET n += {c_1_name: "Anima", c_1_description: "Compose a situated act through full musical C′ Vāk: participation regime, content, position, frame, thread, sequence, actors, authority and intended Return.", c_0_core_nature: "Ta-Onta organ S4′: Compose a situated act through full musical C′ Vāk: participation regime, content, position, frame, thread, sequence, actors, authority and intended Return.", c_1_prior_name: "PiAgent'", c_1_prior_description: "Constitutional and invocation law of the agent; VAK grammar; Anima as root; context-frame execution law", c_1_form: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", vault_path: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/QL-MEF:docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md@6d03a44e5 \\u00a71-\\u00a73\", \"layer_name\": \"organ\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:717864641e063300dc8253f8e51c495fe4a14a5bb01cef6b2cd6076c9e2702ba", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Ta-Onta organ S4′", s_5_runtime_use: "QL semantics; AIKit resolution, Skills and Methods; Actuation agency; Factory commissioned development; Workcell material execution; native surface actions.", s_2_crud_scope: "agent-world composition over native owners; the organ writes nothing of its own", s_3_repository: "EpiLogos/QL-MEF", s_3_checkout: "Work/Quaternal-Logic", s_3_cli: "ql", s_3_source_revision: "6d03a44e5", s_3_owns: ["SP40 Bootstrap / Khora carrier", "SP41 Agent Definition / Hen carrier", "SP42 Permission / Pleroma carrier", "SP43 CF Dispatch / Chronos carrier", "SP44 Vāk and Psyche / Anima carrier", "SP45 Aletheia membrane"], s_3_organ_affinity: "S4 Workcell (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"VAK/ta-onta extension layer where PI agent skills and constitutional modules become operational.\", \"c_1_description\": \"Constitutional and invocation law of the agent; VAK grammar; Anima as root; context-frame execution law\", \"c_1_name\": \"PiAgent'\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S4-S4i-PI-AGENT.md\\\",\\\"layer_name\\\":\\\"ta-onta-extension-architecture\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"s_4_function_role\": \"Prime/inverted S4 operative surface\", \"s_4_s5_agentic_protocol_owner\": \"M5-4\", \"s_5_runtime_use\": \"Constitutional and invocation law of the agent; VAK grammar; Anima as root; context-frame execution law\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S'/S4'/S4'.md\"}", s_0_lineage: "Until 2026-10-20 this node was the reflective stratum PiAgent'; its six children are the organ's recovered positions (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Anima stands on the native owners it specialises: QL semantics; AIKit resolution, Skills and Methods; Actuation agency; Factory commissioned development; Workcell material execution; native surface actions.", q_1_definition: "What it is: Compose a situated act through full musical C′ Vāk: participation regime, content, position, frame, thread, sequence, actors, authority and intended Return.", q_2_operation: "How it acts: Anima governs the composed act through C′ Vāk, with Nous, Logos, Eros, Mythos, Psyche and Sophia as its members: Nous opens ground, Logos distributes usable form, Eros performs according to need, Mythos recognises organising pattern, Psyche keeps contextual continuity, Sophia integrates toward renewed ground.", q_3_pattern: "Its pattern: six first-level positions recovered from the historical strata, SP40 Bootstrap / Khora carrier; SP41 Agent Definition / Hen carrier; SP42 Permission / Pleroma carrier; SP43 CF Dispatch / Chronos carrier; SP44 Vāk and Psyche / Anima carrier; SP45 Aletheia membrane (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", q_4_context: "Where it sits: S4′ of Ta-Onta, the Epi agent world over the products. Same-index affinity with S4 Workcell is structural, not ownership. M5-2 holds it in Epii's spine; M5-4 is where the agents act through it.", q_5_integration: "What returns: Ta-Onta specialises the products' open capabilities for Epi and reproduces none of their storage, parsers, workflow engines, harnesses or desktop; what an act yields returns through the native owners."} REMOVE n.s_4_s5_agentic_protocol_owner;
MATCH (n:Bimba {coordinate:"S5'"}) WHERE n.sync_version = "m5-s-lattice-migration-2026-06-03" AND n.c_1_name = "Sync'" SET n += {c_1_name: "Aletheia", c_1_description: "Disclose what actually happened, compare it with intent, consume thought/activity into useful knowledge and learning, and prepare Recognition or changed ground.", c_0_core_nature: "Ta-Onta organ S5′: Disclose what actually happened, compare it with intent, consume thought/activity into useful knowledge and learning, and prepare Recognition or changed ground.", c_1_prior_name: "Sync'", c_1_prior_description: "Law of what the system draws back; crystallisation contracts; autoresearch and precision loops; Sophia and Aletheia governance", c_1_form: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", vault_path: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", c_1_structure: "{\"authority_spec\": \"EpiLogos/QL-MEF:docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md@6d03a44e5 \\u00a71-\\u00a73\", \"layer_name\": \"organ\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", artifact_kind: "repository_document", content_hash: "sha256:717864641e063300dc8253f8e51c495fe4a14a5bb01cef6b2cd6076c9e2702ba", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Ta-Onta organ S5′", s_5_runtime_use: "Native Activity, Evidence and Return; Central receiving; AIKit knowledge, history and praxis; Factory development evidence; M5′ Epii's evaluation and pedagogy.", s_2_crud_scope: "agent-world composition over native owners; the organ writes nothing of its own", s_3_repository: "EpiLogos/QL-MEF", s_3_checkout: "Work/Quaternal-Logic", s_3_cli: "ql", s_3_source_revision: "6d03a44e5", s_3_owns: ["SP50 Epii Ground/User Position", "SP51 Synthesis Receive/Crystallised Form", "SP52 Retrieval Governance", "SP53 Episodic Pattern Governance", "SP54 Epii Autoresearch/Review", "SP55 Return to Ground"], s_3_organ_affinity: "S5 Quaternal Logic (structural affinity, not exclusive ownership)", s_0_lineage_record: "{\"c_0_core_nature\": \"QL-aware automation, review, knowledge crystallization, and external-return governance over S5.\", \"c_1_description\": \"Law of what the system draws back; crystallisation contracts; autoresearch and precision loops; Sophia and Aletheia governance\", \"c_1_name\": \"Sync'\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S5-S5i-SYNC.md\\\",\\\"layer_name\\\":\\\"epii-knowledge-agent-and-improvement-law\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"s_4_function_role\": \"Prime/inverted S5 operative surface\", \"s_4_s5_agentic_protocol_owner\": \"M5-4\", \"s_5_runtime_use\": \"Law of what the system draws back; crystallisation contracts; autoresearch and precision loops; Sophia and Aletheia governance\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S'/S5'/S5'.md\"}", s_0_lineage: "Until 2026-10-20 this node was the reflective stratum Sync'; its six children are the organ's recovered positions (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "Aletheia stands on the native owners it specialises: Native Activity, Evidence and Return; Central receiving; AIKit knowledge, history and praxis; Factory development evidence; M5′ Epii's evaluation and pedagogy.", q_1_definition: "What it is: Disclose what actually happened, compare it with intent, consume thought/activity into useful knowledge and learning, and prepare Recognition or changed ground.", q_2_operation: "How it acts: Knowledge ingestion and query, thought routing, enrichment, episodic retrieval, alignment and review, with its specialists: Anansi investigates gaps, Janus relates temporal occasions, Moirai supplies evidence, query and reflection modes, Mercurius translates across domains, Agora brings plural contributions into evaluation, Zeithoven develops the next score.", q_3_pattern: "Its pattern: six first-level positions recovered from the historical strata, SP50 Epii Ground/User Position; SP51 Synthesis Receive/Crystallised Form; SP52 Retrieval Governance; SP53 Episodic Pattern Governance; SP54 Epii Autoresearch/Review; SP55 Return to Ground (docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md §2).", q_4_context: "Where it sits: S5′ of Ta-Onta, the Epi agent world over the products. Same-index affinity with S5 Quaternal Logic is structural, not ownership. M5-2 holds it in Epii's spine; M5-4 is where the agents act through it.", q_5_integration: "What returns: Ta-Onta specialises the products' open capabilities for Epi and reproduces none of their storage, parsers, workflow engines, harnesses or desktop; what an act yields returns through the native owners."} REMOVE n.s_4_s5_agentic_protocol_owner;

// @apply roots
MATCH (n:Bimba {coordinate:"S"}) WHERE n.sync_version = "s-branch-live-promotion-v1" AND n.c_1_name = "S Technical Stack" SET n += {c_1_name: "S Product Stack", c_1_description: "The six O:I products that make Epi-Logos technically real: S0 Central, S1 Actuation, S2 AIKit, S3 Software Factory, S4 Workcell and S5 Quaternal Logic. Each owns its domain; capabilities are composed across them.", c_0_core_nature: "The six O:I products that make Epi-Logos technically real: S0 Central, S1 Actuation, S2 AIKit, S3 Software Factory, S4 Workcell and S5 Quaternal Logic. Each owns its domain; capabilities are composed across them.", c_1_prior_name: "S Technical Stack", c_1_prior_description: "Root coordinate branch for the Epi-Logos technical-procedural stack across S0 through S5.", c_1_form: "docs/integrations/epi-logos/epi-ssprime-embodiment.json", vault_path: "docs/integrations/epi-logos/epi-ssprime-embodiment.json", artifact_kind: "repository_document", content_hash: "sha256:781dbe29ca70d2059297c9a75aa869aa85405cfbb85e2a4b0fc665bbf043126a", c_1_structure: "{\"authority_spec\": \"EpiLogos/QL-MEF:docs/integrations/epi-logos/epi-ssprime-embodiment.json@6d03a44e5\", \"layer_name\": \"family-root\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Product coordinate namespace root", s_0_lineage_record: "{\"c_0_core_nature\": \"Root coordinate branch for the Epi-Logos technical-procedural stack across S0 through S5.\", \"c_1_description\": \"Root coordinate branch for the Epi-Logos technical-procedural stack across S0 through S5.\", \"c_1_name\": \"S Technical Stack\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S-STACK-INTEGRATION.md\\\",\\\"layer_name\\\":\\\"technical-stack\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"q_0_runnable_horizon\": \"Before S can stack anything, something must already demand that conception become RUNNABLE — that ontology cash out as actual process, actual persistence, actual I/O. S presupposes the # inversion act and the raw archetypes #0–#5 (CLAUDE.md II.A–B) which it does not contain but manifests; it is the Layer-2 technology-stack descent of a foundation it does not author. Its thrown ground is the bare fact of the machine: that there is silicon, a filesystem, a process table, a socket — a substrate that will accept commands and return exit codes whether or not any meaning has yet been assigned to them. This is the void-pole S lives upon, and it is the most concrete void in the whole coordinate space: not the abyssal silence of M0's Anuttara nor the pre-categorical horizon of C, but the .rodata/Śiva bedrock read as HARDWARE (CLAUDE.md VI) — the immutable substrate that is executed but never persuaded. S arises where the other families' qualifications must become operable: P has fixed a function, M a consciousness-domain, C a type — but none of these RUNS until S grounds it in a spawnable, buildable, addressable plane. The 0-pole here is capacity-to-execute as such: the open affordance of a substrate that can be made to do anything precisely because it yet does nothing. S is what the inversion engine becomes when it stops generating positions and starts asking what each position COSTS to make real.\", \"q_1_technology_manifestation\": \"S IS the technology-stack family — the manifestation of #0–#5 through the single domain of executable technology, the most operationally concrete of the six families (CLAUDE.md II.C). Where the other five families qualify and locate, S MATERIALISES. P fixes a thing's functional-semantic position; M its consciousness-domain (M0 Anuttara … M5 Epii); L its epistemic mode; T its artifact-kind; C its ontological type. S alone answers HOW IT RUNS — through what terminal, what vault, what graph, what gateway, what agent, what world-boundary a thing becomes materially operable. Its substance is the six-layer return circuit named in the S-SYSTEM-INDEX system image: S0 makes the system executable (epi-cli, shell, process, build, the C kernel); S1 makes it resident and typed (the Obsidian vault, markdown, frontmatter, Hen compiler); S2 makes it graph/vector/cache real (raw Neo4j + Redis); S3 makes it temporal and routed (the gateway control plane, session authority); S4 makes it agentically inhabited (the ta-onta package, the 14-agent VAK roster); S5 makes it world-facing and reflective (Gnostic, Graphiti, external connectors). To say what S is, is to say: it is the family in which every coordinate of the whole map acquires a body — the stratum where Epi-Logos stops being conceived and starts being run.\", \"q_2_return_circuit_dynamism\": \"S moves by GROUNDING-then-RETURNING — and the S-SYSTEM-INDEX names its native dynamism exactly: 'The S-family is not a list of services. It is a return circuit.' Each layer couples to the next as an ascending dependency (S0 grounds execution → S1 gives lawful home → S2 provides substrate → S3 gives time and routing → S4 inhabits → S5 returns to world), and then the circuit closes: 'S5 returns to S0 — every decision about Epii, Nara, Gnosis, autoresearch, and review must become executable as CLI/API shape, test harness, bootstrap, and audit trail.' This is the kernel's 4+2 read as infrastructure: S0 and S5 are the two implicate poles (ground and world-return, the conditions), S1–S4 the four explicate layers that traverse the field between them. The coupling is strictly asymmetric and load-bearing: nothing floats above S0 (all six ta-onta extensions consume it; none float above it — S0.md), and nothing is real until it cashes out there. S also carries the base/prime doubling: the prime branch (S0'–S5') makes each base technology carry Epi-Logos ontology, so S's relational signature is dual — a raw substrate spine (S) and its semantic augmentation (S') that together constitute each layer. The family does not merely host services; it pumps the whole system out into operability and back into executable truth.\", \"q_3_layered_dependency_lattice\": \"S's organising structure is a layered dependency lattice — six strata stacked by what-must-run-before-what, not a flat catalogue of tools. Its formal members are the canonical six (CLAUDE.md II.C): S0 Terminal/CLI/C Ground, S1 Obsidian/Material Container, S2 GraphDB Substrate, S3 Gateway Control Plane, S4 Agent Runtime, S5 Integral World Boundary — each with a base technology and a prime augmentation, each owning a primary data authority (runtime facts at S0, vault residency at S1, graph/vector/cache at S2, transport+temporal at S3, agent identity+permission at S4, world-return+M'-outputs at S5). The structural law that hardens the lattice is the import boundary: the forbiddenImports / forbiddenImportsFromLayer matrix machine-enforced in the extension-contract preflight (CLAUDE.md Code Navigability Rule 3), so a lower layer may never reach up into a higher one — dependency points only downward toward ground. Crucially the lattice distinguishes substrate-residency from conceptual-coordinate: a module's physical location need not match its conceptual S-coordinate (graphiti-runtime physically sits at S3 but actualises S5 — CLAUDE.md II.C). The S-coordinate is the conceptual law; physical residency is convenience. The pattern is therefore not a directory tree but a topology of enforced seams: the stack as a stack precisely because each floor bears only the floors above and stands only on the floor below.\", \"q_4_executable_honesty_telos\": \"S exists to make Epi-Logos materially TRUE — so that no claim of the system floats free of a runnable, persisted, verifiable substrate. Its telos is what S0.md names executable honesty: 'whatever is promised in S1', S2', S3', S4', or S5' must cash out here as actual runnable surface, actual persistence, actual I/O contract, and actual reproducible build path.' This is the family's reason to exist and its discipline against vapour: the other families can mean, type, and locate; S is what forbids meaning that cannot be run. Its genealogy is the technology-stack descent of the raw archetypes (#0 ground → S0, #5 integration → S5), and its locality is the whole Body/ code plane — Body/S/S0…S5 — held distinct from the Idea/ vault plane and the Seeds/ spec plane (S-CODE-RESIDENCY-PLAN). The architecture invariant the diagram pack records states the purpose sharply: S0 is the command membrane and return surface, while coordinate-domain law belongs in the owning S1–S5 modules — the core invariant that the coordinate system IS the modular system, never relocated into S0 for convenience (CLAUDE.md DOX). S's why, told whole: to be the plane where the entire map becomes operable, where 'is it real in the stack?' has a single honest answer — can it be spawned, built, persisted, addressed, and verified here?\", \"q_5_mobius_back_to_ground\": \"S closes by being a circuit that LANDS on its own ground and re-opens there. The return is literal in the canon: S5 (world-return: Gnostic, Graphiti, Epii reflection, the Möbius Return) folds back into S0 (executable substrate), because every world-facing decision must become 'executable as CLI/API shape, test harness, bootstrap, and audit trail' (S-SYSTEM-INDEX). This is the matheme's 5→0 read at the scale of the whole stack: the system that has gone out into the world returns not as new content but as new executable ground — the reflection sedimented back into runnable command. S thus enacts 0/1 + 1/0 = 1/1 as infrastructure: S0 (the descent-face, ground as raw execution, the 0/1) and S5 (the ascent-face, world-return as achieved reflection, the 1/0) are one circuit read from its two implicate poles, joined by the twist 5→0 that turns world-return back into ground. And it OPENS rather than concludes because tomorrow's ground is always more than today's: each return deposits new corpus, new episodic memory, new audit trail, new tested surface — the substrate enriched by everything the cycle carried back. The epogdoon η = log(9/8), the whole-tone of generative incompleteness (kernel-spec §0), keeps the circuit one step short of closure: no build is ever final, each S5→S0 return grounds a stack slightly more capable than the one that ran the last cycle. S is the technology that is never finished being made real — the return circuit that re-runs, enriched, forever.\", \"s_4_function_role\": \"Stack coordinate namespace root\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S.canvas\"}", s_0_lineage: "Until 2026-10-20 this root named the technical stack (docs/integrations/epi-logos/epi-ssprime-embodiment.json).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "S stands on the products' own repositories: each product is a native owner with its own CLI, records and tests.", q_1_definition: "What it is: the six products, Central, Actuation, AIKit, Software Factory, Workcell and Quaternal Logic.", q_2_operation: "How it acts: a capability is made technically real by the products that own it, composed across them, never re-implemented by another.", q_3_pattern: "Its pattern: S0 the ground, S1 standing to act, S2 the powers, S3 commissioned work, S4 material execution, S5 reflection.", q_4_context: "Where it sits: beside M and M′, distinct from them. M5-2 holds S in Epii's spine; M5-4 is where the agents act through it. Its prime is S′, Ta-Onta.", q_5_integration: "What returns: evidence and results return to their owners, and through Central's receiving to a person."} REMOVE n.q_0_runnable_horizon, n.q_3_layered_dependency_lattice, n.q_2_return_circuit_dynamism, n.q_1_technology_manifestation, n.q_4_executable_honesty_telos, n.q_5_mobius_back_to_ground;
MATCH (n:Bimba {coordinate:"S'"}) WHERE n.sync_version = "s-branch-live-promotion-v1" AND n.c_1_name = "S' Reflective Technical Stack" SET n += {c_1_name: "S' Ta-Onta Agent World", c_1_description: "Ta-Onta, the Epi agent world: six organs that specialise the products' open capabilities for Epi: S0′ Khora, S1′ Hen, S2′ Pleroma, S3′ Chronos, S4′ Anima and S5′ Aletheia.", c_0_core_nature: "Ta-Onta, the Epi agent world: six organs that specialise the products' open capabilities for Epi: S0′ Khora, S1′ Hen, S2′ Pleroma, S3′ Chronos, S4′ Anima and S5′ Aletheia.", c_1_prior_name: "S' Reflective Technical Stack", c_1_prior_description: "Prime/inverted coordinate branch for QL-aware reflective and agentic surfaces across S0' through S5'.", c_1_form: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", vault_path: "docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md", artifact_kind: "repository_document", content_hash: "sha256:717864641e063300dc8253f8e51c495fe4a14a5bb01cef6b2cd6076c9e2702ba", c_1_structure: "{\"authority_spec\": \"EpiLogos/QL-MEF:docs/integrations/epi-logos/TA-ONTA-FULL-FIELD-LOCK.md@6d03a44e5\", \"layer_name\": \"family-root\", \"promotion_contract\": \"s-sprime-current-2026-10-20\"}", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", s_4_function_role: "Ta-Onta organ namespace root", s_0_lineage_record: "{\"c_0_core_nature\": \"Prime/inverted coordinate branch for QL-aware reflective and agentic surfaces across S0' through S5'.\", \"c_1_description\": \"Prime/inverted coordinate branch for QL-aware reflective and agentic surfaces across S0' through S5'.\", \"c_1_name\": \"S' Reflective Technical Stack\", \"c_1_structure\": \"{\\\"authority_spec\\\":\\\"docs/specs/S/S-STACK-INTEGRATION.md\\\",\\\"layer_name\\\":\\\"reflective-technical-stack\\\",\\\"promotion_contract\\\":\\\"s-branch-live-promotion-v1\\\"}\", \"s_4_function_role\": \"Inverted Stack coordinate namespace root\", \"vault_path\": \"Idea/Bimba/World/Types/Coordinates/S/S'/S'.canvas\"}", s_0_lineage: "Until 2026-10-20 this root named the technical stack (docs/integrations/epi-logos/epi-ssprime-embodiment.json).", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20", q_0_ground: "S′ stands on S: every organ consumes the products' native capabilities and owns no storage of its own.", q_1_definition: "What it is: the six organs of the Epi agent world, Khora, Hen, Pleroma, Chronos, Anima and Aletheia.", q_2_operation: "How it acts: an act is entered (Khora), given form (Hen), given its powers (Pleroma), placed in its times (Chronos), composed (Anima) and disclosed and returned (Aletheia).", q_3_pattern: "Its pattern: six organs of six recovered positions each (SP00–SP55); same-index affinity with the products is structural, not ownership.", q_4_context: "Where it sits: the prime of S, distinct from M and M′. M5-2 holds S′ in Epii's spine; M5-4, with the six agents at M5-4.0–M5-4.5, is where the agents act through it.", q_5_integration: "What returns: what actually happened, compared with intent and turned into knowledge, learning and Recognition."};

// @apply organ positions
