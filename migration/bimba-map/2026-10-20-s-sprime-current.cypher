// @apply M5
MATCH (n:Bimba {coordinate:"M5-2"}) WHERE n.sync_version = "m5-2-3-4-live-thread-migration-2026-06-03" AND n.c_1_name = "Siva-" SET n += {q_1_system_spine_lattice: "What M5-2 IS: the system spine — not generic backend but all S/S' as a full nodal structure, Epii's direct M view into the entire technical-and-reflective stack as one lattice (s_2_coordinate_scope: 'S/S' complete system-spine lattice'; query-prefixes S, S'). Its substance is the six products (S0 Central, S1 Actuation, S2 AIKit, S3 Software Factory, S4 Workcell, S5 Quaternal Logic) and the six Ta-Onta organs of S′ (Khora, Hen, Pleroma, Chronos, Anima, Aletheia), with the databases, knowledge graph, services, schema law and code provenance that constitute the material body of the Epi-Logos system. As #2 Operation it is the agent-agnostic processing foundation: the QL 0–5 synthesis-cycle substrate where specialized agents instantiate, each subsystem both executing and executed by the architecture. Prakrti made addressable: the whole stack held as coordinate structure, the Backend Studio its M' rendered face but the lattice its true name.", q_3_s_sprime_nodal_structure: "Structurally M5-2 is the S/S' nodal lattice itself — 'not generic backend; it is all S/S' as a full nodal structure.' Its pattern is the complete stack rendered as coordinate-addressable graph: S0 Central, S1 Actuation, S2 AIKit, S3 Software Factory, S4 Workcell, S5 Quaternal Logic, with the Ta-Onta organs as their primes, each carrying runtime properties (repositories, owners, commands, tests, provenance) so the spine is usable at runtime, not merely named. As #2 Operation within Epii's synthetic domain it is the entity-layer made structural: the system's material body held so the orchestration can reach any organ by coordinate. The form is a lattice that bears — a skeleton of typed nodes, the stable architecture (Siva-hardware, the resonant medium of Space) whose every joint is a queryable coordinate.", s_2_coordinate_scope: "S/S′: the six products and the six Ta-Onta organs, held as Epii's system spine", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20"};
MATCH (n:Bimba {coordinate:"M5-4"}) WHERE n.sync_version = "m5-2-3-4-live-thread-migration-2026-06-03" AND n.c_1_name = "Siva-Shakti" SET n += {q_1_agentic_protocol_seam: "What M5-4 IS: the agentic-protocol and operational-capacity layer — 'not merely a UI room; it is the protocol seam where stack, expression, and agentic governance become operational.' Its substance is mediation: the Orchestrator that bridges the agent-agnostic QL pipeline (Siva-) with the specific cognitive functions of the agents, where backend databases and processing dynamically interact with the rendered map and the user's lived experience. Scope is the whole S/S′ field, the six products and the six Ta-Onta organs, as the agents act through them (s_4_s5_coordinate_scope; prefixes S, S′); affordance is VAK/agent-runtime protocol mediation; promotion is review/autoresearch/human-validation governed. As #4 Type it is the sacred technological marriage made operable — processing-power serving experiential-wisdom rather than replacing it. The Agentic Control Room is its M' face; the protocol seam is its true office.", s_4_s5_coordinate_scope: "S/S′: the six products and the six Ta-Onta organs, as the agents act through them", t_4_protocol_scope: "S/S′ (products and organs), M′ agentic affordances, operational capacities", c_1_coordinate_role: "System agentic protocols: mediation of S/S′ (products and organs), M′, review, runtime agency and operational capacities.", c_1_prior_coordinate_role: "System agentic protocols: mediation of S/S', M', S4/S5 review, runtime agency, and operational capacities.", s_2_query_prefixes: ["S", "S'"], promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20"};
MATCH (n:Bimba {coordinate:"M5-3"}) WHERE n.sync_version = "m5-2-3-4-live-thread-migration-2026-06-03" AND n.c_1_name = "-Shakti" SET n += {c_1_coordinate_role: "System expression: Epii's direct M view into the full M′ field as O:I renders it, the cradle and the DLW.", c_1_prior_coordinate_role: "System expression: direct M view into the full M' rendered Pratibimba/Theia coordinate field.", q_1_mprime_expression_plane: "What M5-3 IS: the system expression — not generic frontend but the M' expression-plane as rendered system expression, Epii's direct M view into the full M' rendered Pratibimba coordinate field as O:I renders it (the cradle and the DLW) (m_2_coordinate_scope: 'M' complete expression lattice'; query-prefix M'). Its substance is the rendered Pratibimba of the whole bimba map: M0' graph systems and planetary continuity, M1' the torus, M2' the synth and the sky, M3' the codon clock and the deck, M4' Expressions, M5' Technē — the synaesthetic interfaces, visualization systems, and phenomenological-accessibility surfaces that make the system's computational depths experientially available rather than hidden machinery. As #3 Process it is the canvas-plane where backend abstraction becomes beheld: Purusha's seeing, Shakti's beauty. The Frontend Studio is its M' face; the M' expression-lattice is its true extent.", q_3_rendered_pratibimba_lattice: "Structurally M5-3 is the M' rendered-Pratibimba lattice — 'the M' expression-plane as rendered system expression,' the complete coordinate field of O:I's surfaces (the cradle and the DLW). Its pattern is bimba-map-reflected: each M0'–M5' surface a rendered face of its M-domain, plus O:I's devices, panes, widgets, routes and kernel-bridge consumers — the whole bimba map given a perceptible double. As #3 Pattern within Epii's synthetic domain it is the canvas/workspace made structural: the expression-plane held as coordinate lattice so any rendered surface is reachable by M'-coordinate. The form is a mirror-field — not the substrate but its reflection arranged as typed nodes, the Pratibimba surface whose every face answers to a bimba depth. Structure as appearance: the pattern by which the system shows itself to itself and to its user.", m_3_application: "O:I, the cradle and the DLW (EpiLogos/O-I: desktop/cradle and packages/live-shell)", m_3_modes: "{\"m_prime_modes\": \"The six M′ layers are four modes, 3:1 = 3:3: Live holds M1′, M2′ and M3′; Expressions is M4′; Technē is M5′; M0′ is the graph systems and the planetary continuity between local and collective.\", \"s_frame_modes\": {\"Central\": \"S0\", \"Factory\": \"S(0/1/2/3): Factory depends on S0 Central, S1 Actuation and S2 AIKit\"}}", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20"};

// @apply M prime
MATCH (n:Bimba {coordinate:"M'"}) WHERE n.sync_version = "m5-2-3-4-live-thread-migration-2026-06-03" AND n.c_1_name = "M' Pratibimba Expression" SET n += {c_1_description: "Rendered, playable Pratibimba expression of the M/Bimba map across M0'-M5' in O:I (the cradle and the DLW).", c_1_prior_description: "Rendered, playable Pratibimba expression of the M/Bimba map across M0'-M5' in the Theia shell.", m_0_repo_path: "Work/O-I (desktop/cradle, packages/live-shell)", m_0_prior_repo_path: "Body/M/epi-theia", m_3_rendered_affordance: "O:I expression plane: the cradle and the DLW", m_3_prior_rendered_affordance: "Theia/Pratibimba expression plane", m_3_modes: "{\"m_prime_modes\": \"The six M′ layers are four modes, 3:1 = 3:3: Live holds M1′, M2′ and M3′; Expressions is M4′; Technē is M5′; M0′ is the graph systems and the planetary continuity between local and collective.\", \"s_frame_modes\": {\"Central\": \"S0\", \"Factory\": \"S(0/1/2/3): Factory depends on S0 Central, S1 Actuation and S2 AIKit\"}}", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20"};
MATCH (n:Bimba {coordinate:"M0'"}) WHERE n.sync_version = "m5-2-3-4-live-thread-migration-2026-06-03" AND n.c_1_name = "Anuttara'" SET n += {c_1_description: "The app layer of M0 Anuttara: graph systems (the Bimba map and the knowledge graphs drawn as ground) and the planetary continuity between local and collective, a person's own World joined to the shared field.", c_1_coordinate_role: "App layer of M0 Anuttara", m_2_parent_subsystem: "M0", m_3_application_layer: "Graph systems and planetary continuity", m_3_mode: "M0′: graph systems and the planetary continuity between local and collective", m_3_application: "O:I, the cradle and the DLW (EpiLogos/O-I: desktop/cradle and packages/live-shell)", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20"};
MATCH (n:Bimba {coordinate:"M1'"}) WHERE n.sync_version = "m5-2-3-4-live-thread-migration-2026-06-03" AND n.c_1_name = "Paramasiva'" SET n += {c_1_description: "The app layer of M1 Paramaśiva: generation. The torus is the only source of sound; Live plays it with M2′ and M3′.", c_1_coordinate_role: "App layer of M1 Paramaśiva", m_2_parent_subsystem: "M1", m_3_application_layer: "The torus: generation", m_3_mode: "Live", m_3_application: "O:I, the cradle and the DLW (EpiLogos/O-I: desktop/cradle and packages/live-shell)", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20"};
MATCH (n:Bimba {coordinate:"M2'"}) WHERE n.sync_version = "m5-2-3-4-live-thread-migration-2026-06-03" AND n.c_1_name = "Parashakti'" SET n += {c_1_description: "The app layer of M2 Paraśakti: modulation. The synth, moved by the live sky and tuned by the lenses; part of Live.", c_1_coordinate_role: "App layer of M2 Paraśakti", m_2_parent_subsystem: "M2", m_3_application_layer: "The synth and the sky: modulation", m_3_mode: "Live", m_3_application: "O:I, the cradle and the DLW (EpiLogos/O-I: desktop/cradle and packages/live-shell)", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20"};
MATCH (n:Bimba {coordinate:"M3'"}) WHERE n.sync_version = "m5-2-3-4-live-thread-migration-2026-06-03" AND n.c_1_name = "Mahamaya'" SET n += {c_1_description: "The app layer of M3 Mahāmāyā: form and time. The codons, the clock and the deck; part of Live.", c_1_coordinate_role: "App layer of M3 Mahāmāyā", m_2_parent_subsystem: "M3", m_3_application_layer: "The codon clock and the deck: form and time", m_3_mode: "Live", m_3_application: "O:I, the cradle and the DLW (EpiLogos/O-I: desktop/cradle and packages/live-shell)", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20"};
MATCH (n:Bimba {coordinate:"M4'"}) WHERE n.sync_version = "m5-2-3-4-live-thread-migration-2026-06-03" AND n.c_1_name = "Nara'" SET n += {c_1_description: "The app layer of M4 Nara: Expressions, the lived application, where a scene holds M1′–M3′ with a person's own occasion.", c_1_coordinate_role: "App layer of M4 Nara", m_2_parent_subsystem: "M4", m_3_application_layer: "Expressions", m_3_mode: "Expressions", m_3_application: "O:I, the cradle and the DLW (EpiLogos/O-I: desktop/cradle and packages/live-shell)", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20"};
MATCH (n:Bimba {coordinate:"M5'"}) WHERE n.sync_version = "m5-2-3-4-live-thread-migration-2026-06-03" AND n.c_1_name = "Epii'" SET n += {c_1_description: "The app layer of M5 Epii: Technē, the deep-working application of knowledge, construction and review. It contains the Backend Studio (M5-2′), the Frontend Studio (M5-3′) and the Agentic Control Room (M5-4′).", c_1_coordinate_role: "App layer of M5 Epii", m_2_parent_subsystem: "M5", m_3_application_layer: "Technē", m_3_mode: "Technē", m_3_application: "O:I, the cradle and the DLW (EpiLogos/O-I: desktop/cradle and packages/live-shell)", promotion_source: "owner ruling 2026-10-20 (claude-code:agency-ground)", sync_status: "s_sprime_current_2026_10_20", sync_version: "s-sprime-current-2026-10-20"};

