// @apply nucleotide coin values and line names (set only where absent)
MATCH (n:Nucleotide {coordinate:'M3-2-1'}) WHERE n.m_3_2_coin_value IS NULL SET n.m_3_2_coin_value = 6, n.m_3_2_iching_line = 'Old Yin', n.m_3_2_polarity = 'yin', n.m_3_2_mobility = 'moving';
MATCH (n:Nucleotide {coordinate:'M3-2-2'}) WHERE n.m_3_2_coin_value IS NULL SET n.m_3_2_coin_value = 9, n.m_3_2_iching_line = 'Old Yang', n.m_3_2_polarity = 'yang', n.m_3_2_mobility = 'moving';
MATCH (n:Nucleotide {coordinate:'M3-2-3'}) WHERE n.m_3_2_coin_value IS NULL SET n.m_3_2_coin_value = 8, n.m_3_2_iching_line = 'Young Yin', n.m_3_2_polarity = 'yin', n.m_3_2_mobility = 'resting';
MATCH (n:Nucleotide {coordinate:'M3-2-4'}) WHERE n.m_3_2_coin_value IS NULL SET n.m_3_2_coin_value = 7, n.m_3_2_iching_line = 'Young Yang', n.m_3_2_polarity = 'yang', n.m_3_2_mobility = 'resting';

// @report
MATCH (g:GenerationEvent) RETURN count(g) AS cells;
MATCH (:GenerationEvent)-[r:YIELDS_CODON]->() RETURN count(r) AS yields;
MATCH (g:GenerationEvent)-[:IS_CLASSIFIED_AS]->(k:Classifier) RETURN k.c_1_name AS class, count(g) AS cells ORDER BY class;
MATCH (c:Codon) RETURN c.c_3_symmetry_class AS class, count(c) AS codons ORDER BY class;
MATCH (g:GenerationEvent) WHERE NOT (g)-[:USES_PAIR]->() OR NOT (g)-[:IS_CLASSIFIED_AS]->() OR NOT ()-[:INITIATES]->(g) RETURN count(g) AS incomplete_cells;
