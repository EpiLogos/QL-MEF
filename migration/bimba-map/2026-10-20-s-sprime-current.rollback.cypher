MATCH (n:Bimba {coordinate:"S2'"}) SET n += {c_1_name: "Neo4j'", c_1_description: "Graph query law; cross-namespace edge typing; reranking contract; what the graph is permitted to return", c_0_core_nature: "GraphRAG, coordinate-aware retrieval, graph promotion planning, and graph/episodic routing boundary.", c_1_prior_name: "Neo4j'", c_1_prior_description: "GraphRAG, coordinate-aware retrieval, graph promotion planning, and graph/episodic routing boundary.", c_1_form: "", vault_path: "Idea/Bimba/World/Types/Coordinates/S/S'/S2'/S2'.md", c_1_structure: "{\"authority_spec\":\"docs/specs/S/S2-S2i-GRAPH.md\",\"layer_name\":\"ql-graph\",\"promotion_contract\":\"s-branch-live-promotion-v1\"}", artifact_kind: "vault_markdown", content_hash: "sha256:e8cb1d03433c4258f17a1d5857aca545ae23ea8a59c047bb84dc85ac74ee7f2f", promotion_source: "pi_agent", s_4_function_role: "Prime/inverted S2 operative surface", s_5_runtime_use: "Graph query law; cross-namespace edge typing; reranking contract; what the graph is permitted to return", s_2_crud_scope: "graph node/relation CRUD, schema, ingestion, retrieval", sync_status: "m5_s_lattice_integrated", sync_version: "m5-s-lattice-migration-2026-06-03", s_4_translation_schema: "{\"coordinate_property_families\":[\"c\",\"p\",\"l\",\"s\",\"t\",\"m\",\"q\"],\"inversion_property_key\":\"i\",\"graphiti_runtime_authority\":\"S3 graphiti runtime adapter\",\"graphiti_invocation_owner\":\"S5 episodic invocation and arc governance\"}", s_4_queryable_properties: "{\"frontmatter_rules\":\"agent-facing rulebook\",\"property_proposals\":\"evidence-backed schema validation\",\"code_provenance\":\"S/S' and M' implementation evidence\"}", s_4_output_contracts: "{\"neo4j\":\"validated coordinate graph state\",\"graphiti_plan\":\"s5.episodic.deposit invocation plan\"}", s_4_input_contracts: "{\"hen\":\"artifact evidence and wikilink relation evidence\",\"pi_pleroma\":\"agent property and relation proposals\",\"s3\":\"Graphiti episode deposit method\"}"} REMOVE 