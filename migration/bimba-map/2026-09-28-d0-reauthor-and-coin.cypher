MATCH (n:Bimba {coordinate:'M3-2-1-3'}) WHERE n.c_3_sum_value = 13 AND n.c_3_difference_value = -1 SET n.c_3_sum_value = 14, n.c_3_difference_value = -2;
// M3-2-1-4 AG: difference 2 disagreed with its own table (x - y = -2); corrected below.
MATCH (n:Bimba {coordinate:'M3-2-1-4'}) WHERE n.c_3_sum_value = 14 AND n.c_3_difference_value = 2 SET n.c_3_sum_value = 13, n.c_3_difference_value = -1;
// M3-2-2-3 TC: difference -2 disagreed with its own table (x - y = 2); corrected below.
MATCH (n:Bimba {coordinate:'M3-2-2-3'}) WHERE n.c_3_sum_value = 16 AND n.c_3_difference_value = -2 SET n.c_3_sum_value = 17, n.c_3_difference_value = 1;
MATCH (n:Bimba {coordinate:'M3-2-2-4'}) WHERE n.c_3_sum_value = 17 AND n.c_3_difference_value = 1 SET n.c_3_sum_value = 16, n.c_3_difference_value = 2;
