MATCH (n:Bimba {coordinate:'M3-2-4'}) WHERE n.c_3_integral_pp = 92 AND n.c_3_integral_pn = 32 AND n.c_3_integral_np = 32 AND n.c_3_integral_nn = -28 SET n.c_3_integral_pp = 88, n.c_3_integral_pn = 28, n.c_3_integral_np = 28, n.c_3_integral_nn = -32;

// @report
MATCH (n:Bimba) WHERE n.m_2_5_interval_from_root IS NOT NULL RETURN 'planets' AS k, count(n) AS n
UNION ALL MATCH ()-[r]->() WHERE r.m_2_4_planetary_color IS NOT NULL RETURN 'shem colours' AS k, count(r) AS n
UNION ALL MATCH (n:Bimba) WHERE n.m_3_1_associated_codons IS NOT NULL RETURN 'hexagram pairings' AS k, count(n) AS n;
