MATCH (n:Bimba {coordinate:'M3-2-4-1'}) WHERE n.c_3_sum_value = 14 AND n.c_3_difference_value = 2 SET n.c_3_sum_value = 13, n.c_3_difference_value = 1;
MATCH (n:Bimba {coordinate:'M3-2-4-2'}) WHERE n.c_3_sum_value = 17 AND n.c_3_difference_value = -1 SET n.c_3_sum_value = 16, n.c_3_difference_value = -2;
MATCH (n:Bimba {coordinate:'M3-2-4-3'}) WHERE n.c_3_sum_value = 15 AND n.c_3_difference_value = 1 SET n.c_3_sum_value = 15, n.c_3_difference_value = -1;
