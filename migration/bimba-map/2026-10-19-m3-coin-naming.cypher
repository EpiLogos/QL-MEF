// @apply M3-2 ground, alphabet and purpose
MATCH (n {coordinate:'M3-2'}) WHERE n.q_0_nucleotide_charge_ground CONTAINS "Adenine the primary Yang (purine, double-ring, 2 hydrogen bonds, integrals pp 84 / nn −36) and Thymine the primary Yin (pyrimidine, single-ring, pp 96 / nn −24) stand as the Taoist poles — white-active-expanding against black-passive-contracting, Pingala against Ida, Fire against Water." SET n.q_0_nucleotide_charge_ground = replace(n.q_0_nucleotide_charge_ground, "Adenine the primary Yang (purine, double-ring, 2 hydrogen bonds, integrals pp 84 / nn −36) and Thymine the primary Yin (pyrimidine, single-ring, pp 96 / nn −24) stand as the Taoist poles — white-active-expanding against black-passive-contracting, Pingala against Ida, Fire against Water.", "Adenine, Old Yin 6 (purine, double-ring, 2 hydrogen bonds, integrals pp 84 / nn −36), and Thymine, Old Yang 9 (pyrimidine, single-ring, pp 96 / nn −24), stand as the moving poles — Ida against Pingala, Water against Fire — while Cytosine, Young Yin 8, and Guanine, Young Yang 7, are the poles at rest, Earth and Air.");
MATCH (n {coordinate:'M3-2'}) WHERE n.q_0_nucleotide_charge_ground CONTAINS "(`Z₄ ≅ Z₂ × Z₂`, purine/pyrimidine × amino/keto)" SET n.q_0_nucleotide_charge_ground = replace(n.q_0_nucleotide_charge_ground, "(`Z₄ ≅ Z₂ × Z₂`, purine/pyrimidine × amino/keto)", "(`Z₄ ≅ Z₂ × Z₂`: yin/yang × moving/resting, chemically amino/keto × weak/strong hydrogen bonding; purine/pyrimidine is their difference)");
MATCH (n {coordinate:'M3-2'}) WHERE n.q_1_sixty_four_codon_alphabet CONTAINS "Codon_AAA the \"Pure Yang Trinity\"" SET n.q_1_sixty_four_codon_alphabet = replace(n.q_1_sixty_four_codon_alphabet, "Codon_AAA the \"Pure Yang Trinity\"", "Codon_AAA the \"Old Yin Trinity\"");
MATCH (n {coordinate:'M3-2'}) WHERE n.q_4_language_life_writes_itself CONTAINS "position 1 = real = A = Material cause = Earth = Sensation; i = U = Efficient = Water = Feeling; j = G = Formal = Air = Thinking; k = C = Context = Fire = Intuition." SET n.q_4_language_life_writes_itself = replace(n.q_4_language_life_writes_itself, "position 1 = real = A = Material cause = Earth = Sensation; i = U = Efficient = Water = Feeling; j = G = Formal = Air = Thinking; k = C = Context = Fire = Intuition.", "position 1 = real = C = Material cause = Earth = Sensation; i = T (U) = Context = Fire = Intuition; j = A = Efficient = Water = Feeling; k = G = Formal = Air = Thinking.");

